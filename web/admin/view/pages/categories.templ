package pages

import (
	"main/web/admin/view"
	"main/web/admin/view/ui"
)

templ Categories() {
	@view.AdminLayout() {
		<script>
			const categoriesConfig = {
				filters: {
					search: '',
					path: '',
					level: '',
					parentId: '',
					type: '',
					vehicleIds: [],
					makerIds: [],
					modelIds: [],
					typeIds: [],
					categoryIds: [],
					isActive: ''
				},
				pagination: {
					currentPage: 1,
					pageSize: 100,
					totalPages: 1,
					totalItems: 0
				},
				showDialog: false,
				showConfirmDialog: false,
				editingItem: null,
				itemToDelete: null,
				isAddingChild: false,
				parentForChild: null,
				formData: {
					name: '',
					label: '',
					description: '',
					parentId: null,
					sortOrder: 0,
					isActive: true
				},
				expandedNodes: new Set(),

				init() {
					this.loadFilters();
					this.loadInitialData();
					// Initialize all nodes as expanded by default
					this.$nextTick(() => {
						document.querySelectorAll('.children-container').forEach(container => {
							container.classList.remove('hidden');
						});
					});
				},

				async loadFilters() {
					// Load filter options for each type
					try {
						const [vehicles, makers, models, types, categories] = await Promise.all([
							this.loadCategoriesByType('vehicle'),
							this.loadCategoriesByType('maker'),
							this.loadCategoriesByType('model'),
							this.loadCategoriesByType('type'),
							this.loadCategoriesByType('parts')
						]);
						
						this.filterOptions = {
							vehicles,
							makers,
							models,
							types,
							categories
						};
					} catch (error) {
						console.error('Failed to load filter options:', error);
					}
				},

				async loadCategoriesByType(type) {
					const response = await fetch(`/admin/categories/by-type/${type}`);
					const data = await response.json();
					return data.categories || [];
				},

				loadInitialData() {
					this.applyFilters();
				},

				applyFilters() {
					const params = new URLSearchParams();
					
					if (this.filters.search) params.append('search', this.filters.search);
					if (this.filters.path) params.append('path', this.filters.path);
					if (this.filters.level) params.append('level', this.filters.level);
					if (this.filters.parentId) params.append('parentId', this.filters.parentId);
					if (this.filters.type) params.append('type', this.filters.type);
					if (this.filters.isActive !== '') params.append('isActive', this.filters.isActive);
					
					if (this.filters.vehicleIds.length) {
						this.filters.vehicleIds.forEach(id => params.append('vehicleIds', id));
					}
					if (this.filters.makerIds.length) {
						this.filters.makerIds.forEach(id => params.append('makerIds', id));
					}
					if (this.filters.modelIds.length) {
						this.filters.modelIds.forEach(id => params.append('modelIds', id));
					}
					if (this.filters.typeIds.length) {
						this.filters.typeIds.forEach(id => params.append('typeIds', id));
					}
					if (this.filters.categoryIds.length) {
						this.filters.categoryIds.forEach(id => params.append('categoryIds', id));
					}
					
					params.append('treeView', 'true');
					
					htmx.ajax('GET', `/admin/categories/list?${params.toString()}`, {
						target: '#categories-tree-container',
						swap: 'innerHTML'
					});
				},

				clearFilters() {
					this.filters = {
						search: '',
						path: '',
						level: '',
						parentId: '',
						type: '',
						vehicleIds: [],
						makerIds: [],
						modelIds: [],
						typeIds: [],
						categoryIds: [],
						isActive: ''
					};
					this.applyFilters();
				},

				addItem() {
					this.resetForm();
					this.editingItem = null;
					this.isAddingChild = false;
					this.parentForChild = null;
					this.showDialog = true;
				},

				addChildCategory(parentId, parentName) {
					this.resetForm();
					this.editingItem = null;
					this.isAddingChild = true;
					this.parentForChild = { id: parentId, name: parentName };
					this.formData.parentId = parentId;
					this.showDialog = true;
				},

				editCategory(item) {
					this.resetForm();
					this.editingItem = item;
					this.isAddingChild = false;
					this.parentForChild = null;
					this.formData = {
						name: item.name || '',
						label: item.label || '',
						description: item.description || '',
						parentId: item.parentId || null,
						sortOrder: item.sortOrder || 0,
						isActive: item.isActive !== undefined ? item.isActive : true
					};
					this.showDialog = true;
				},

				resetForm() {
					this.formData = {
						name: '',
						label: '',
						description: '',
						parentId: null,
						sortOrder: 0,
						isActive: true
					};
				},

				deleteCategory(item) {
					this.itemToDelete = item;
					this.showConfirmDialog = true;
				},

				closeDialog() {
					this.showDialog = false;
					this.resetForm();
					this.editingItem = null;
					this.isAddingChild = false;
					this.parentForChild = null;
				},

				confirmAction() {
					if (this.itemToDelete) {
						htmx.ajax('DELETE', `/admin/categories/${this.itemToDelete.id}`, {
							target: '#categories-tree-container',
							swap: 'innerHTML'
						});
						this.itemToDelete = null;
						this.showConfirmDialog = false;
					}
				},

				submitForm() {
					const method = this.editingItem ? 'PUT' : 'POST';
					const url = this.editingItem ? `/admin/categories/${this.editingItem.id}` : '/admin/categories';
					if (!this.editingItem) {
						delete this.formData.parentId
					}
					htmx.ajax(method, url, {
						values: this.formData,
						target: '#categories-tree-container',
						swap: 'innerHTML'
					}).then(() => {
						console.log('Category submitted successfully');
						this.closeDialog();
					}).catch((error) => {
						console.error('Error submitting category:', error);
					});
				},

				toggleNode(categoryId) {
					const node = document.getElementById(`children-${categoryId}`);
					const button = document.querySelector(`[data-category-id="${categoryId}"] .expand-toggle`);
					const icon = button?.querySelector('.expand-icon');
					
					if (node) {
						const isExpanded = !node.classList.contains('hidden');
						
						if (isExpanded) {
							// Collapse
							node.classList.add('hidden');
							icon?.classList.add('rotate-[-90deg]');
							this.expandedNodes.delete(categoryId);
						} else {
							// Expand
							node.classList.remove('hidden');
							icon?.classList.remove('rotate-[-90deg]');
							this.expandedNodes.add(categoryId);
						}
					}
				}
			};

			// Make functions globally available
			window.addChildCategory = (parentId, parentName) => categoriesConfig.addChildCategory(parentId, parentName);
			window.editCategory = (item) => categoriesConfig.editCategory(item);
			window.deleteCategory = (item) => categoriesConfig.deleteCategory(item);
			window.toggleNode = (categoryId) => categoriesConfig.toggleNode(categoryId);
		</script>

		<div x-data="categoriesConfig">
			<!-- Header -->
			<div class="mb-6">
				<h1 class="text-2xl font-bold text-gray-900">Categories Management</h1>
				<p class="mt-1 text-sm text-gray-600">Manage your category hierarchy with vehicles, makers, models, types, and parts.</p>
			</div>

			<!-- Add Button -->
			<div class="mb-6">
				<button 
					@click="addItem()"
					class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-md transition-colors duration-150"
				>
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
					</svg>
					Add Category
				</button>
			</div>

			<!-- Filters -->
			<div class="mb-6 bg-white rounded-lg shadow p-6">
				<h3 class="text-lg font-medium text-gray-900 mb-4">Filters</h3>
				
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
					<!-- Search -->
					<div>
						<label class="block text-sm font-medium text-gray-700 mb-1">Search</label>
						<input 
							type="text" 
							x-model="filters.search"
							@input.debounce.300ms="applyFilters()"
							placeholder="Search categories..."
							class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
						/>
					</div>

					<!-- Path Filter -->
					<div>
						<label class="block text-sm font-medium text-gray-700 mb-1">Path</label>
						<input 
							type="text" 
							x-model="filters.path"
							@input.debounce.300ms="applyFilters()"
							placeholder="Filter by path..."
							class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
						/>
					</div>

					<!-- Level Filter -->
					<div>
						<label class="block text-sm font-medium text-gray-700 mb-1">Level</label>
						<select 
							x-model="filters.level"
							@change="applyFilters()"
							class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
						>
							<option value="">All levels</option>
							<option value="0">Level 0 (Vehicle)</option>
							<option value="1">Level 1 (Maker)</option>
							<option value="2">Level 2 (Model)</option>
							<option value="3">Level 3 (Type)</option>
							<option value="4">Level 4 (Parts)</option>
						</select>
					</div>

					<!-- Type Filter -->
					<div>
						<label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
						<select 
							x-model="filters.type"
							@change="applyFilters()"
							class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
						>
							<option value="">All types</option>
							<option value="vehicle">Vehicle</option>
							<option value="maker">Maker</option>
							<option value="model">Model</option>
							<option value="type">Type</option>
							<option value="parts">Parts</option>
						</select>
					</div>

					<!-- Status Filter -->
					<div>
						<label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
						<select 
							x-model="filters.isActive"
							@change="applyFilters()"
							class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
						>
							<option value="">All</option>
							<option value="true">Active</option>
							<option value="false">Inactive</option>
						</select>
					</div>
				</div>

				<!-- Clear Filters Button -->
				<div class="mt-4">
					<button 
						@click="clearFilters()"
						class="inline-flex items-center px-3 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors duration-150"
					>
						<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
						</svg>
						Clear Filters
					</button>
				</div>
			</div>

			<!-- Categories Tree Container -->
			<div 
				hx-get="/admin/categories/list?treeView=true"
				hx-trigger="load"
				hx-target="#categories-tree-container"
				hx-swap="innerHTML"
				id="categories-tree-container"
				class="overflow-hidden"
			>
				<!-- Loading state -->
				<div class="bg-white rounded-lg shadow p-8 text-center">
					<div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500 mx-auto"></div>
					<p class="mt-4 text-gray-600">Loading categories...</p>
				</div>
			</div>
			
			@CategoryDialog()
			@ui.ConfirmDialog("Delete Category", "Are you sure you want to delete this category? This action cannot be undone and will fail if the category has children or is associated with products.")
		</div>
	}
}

templ CategoryDialog() {
	@ui.FormDialog("Category Details", "lg") {
		<form 
			id="category-form"
			class="space-y-4"
			hx-target="#categories-tree-container"
			hx-swap="innerHTML"
			@htmx:after-request="if($event.detail.successful) closeDialog()"
		>
			<input type="hidden" name="Id" x-bind:value="editingItem ? editingItem.id : ''" />
			
			<!-- Parent Info (when adding child) -->
			<div x-show="isAddingChild && parentForChild" class="p-3 bg-blue-50 rounded-lg border border-blue-200">
				<p class="text-sm text-blue-800">
					<span class="font-medium">Adding child category to:</span>
					<span x-text="parentForChild?.name"></span>
				</p>
			</div>
			
			<!-- Category Name -->
			<div>
				<label for="category-name" class="block text-sm font-medium text-gray-700 mb-1">Category Name</label>
				<input 
					type="text" 
					id="category-name" 
					name="Name"
					x-model="formData.name"
					required
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
				/>
			</div>
			
			<!-- Category Label -->
			<div>
				<label for="category-label" class="block text-sm font-medium text-gray-700 mb-1">Label (Optional)</label>
				<input 
					type="text" 
					id="category-label" 
					name="Label"
					x-model="formData.label"
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
				/>
			</div>
			
			<!-- Read-only fields when editing -->
			<div x-show="editingItem" class="space-y-4">
				<div class="grid grid-cols-2 gap-4">
					<div>
						<label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
						<input 
							type="text" 
							x-bind:value="editingItem?.type"
							disabled
							class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-100 text-gray-500"
						/>
					</div>
					<div>
						<label class="block text-sm font-medium text-gray-700 mb-1">Level</label>
						<input 
							type="text" 
							x-bind:value="editingItem?.level"
							disabled
							class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-100 text-gray-500"
						/>
					</div>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
					<input 
						type="text" 
						x-bind:value="editingItem?.slug"
						disabled
						class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-100 text-gray-500"
					/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Path</label>
					<input 
						type="text" 
						x-bind:value="editingItem?.path"
						disabled
						class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-100 text-gray-500"
					/>
				</div>
			</div>
			
			<!-- Description -->
			<div>
				<label for="category-description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
				<textarea 
					id="category-description" 
					name="Description"
					x-model="formData.description"
					rows="3"
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
				></textarea>
			</div>
			
			<!-- Sort Order -->
			<div>
				<label for="category-sort" class="block text-sm font-medium text-gray-700 mb-1">Sort Order</label>
				<input 
					type="number" 
					id="category-sort" 
					name="SortOrder"
					x-model="formData.sortOrder"
					min="0"
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
				/>
			</div>
			
			<!-- Active Status -->
			<div class="flex items-center">
				<input 
					type="checkbox" 
					id="category-active" 
					name="IsActive"
					x-model="formData.isActive"
					class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
				/>
				<label for="category-active" class="ml-2 block text-sm text-gray-900">Active</label>
			</div>
			
			<!-- Hidden parent ID field -->
			<input type="hidden" name="ParentId" x-bind:value="formData.parentId" />
			
			<div class="flex justify-end space-x-3 pt-4">
				<button 
					type="button" 
					@click="closeDialog()"
					class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 border border-gray-300 rounded-md hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
				>
					Cancel
				</button>
				<button 
					type="button"
					@click="submitForm()"
					class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
				>
					<span x-text="editingItem ? 'Update Category' : (isAddingChild ? 'Add Child Category' : 'Create Category')"></span>
				</button>
			</div>
		</form>
	}
} 