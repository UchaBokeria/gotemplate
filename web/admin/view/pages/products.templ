package pages

import (
	"main/web/admin/view"
	"main/web/admin/view/ui"
)

templ Products() {
	@view.AdminLayout() {
		<script>
			// Category Selector Component
			const categorySelector = {
				searchQuery: '',
				isDropdownOpen: false,
				availableCategories: [],
				filteredCategories: [],
				selectedCategories: [],

				init() {
					this.loadCategories();
				},

				async loadCategories() {
					try {
						const response = await fetch('/admin/categories/list-for-products');
						const data = await response.json();
						this.availableCategories = data.categories || [];
						this.filteredCategories = this.availableCategories;
					} catch (error) {
						console.error('Failed to load categories:', error);
					}
				},

				openDropdown() {
					this.filterCategories();
					this.isDropdownOpen = true;
				},

				closeDropdown() {
					this.isDropdownOpen = false;
					this.searchQuery = '';
				},

				filterCategories() {
					if (!this.searchQuery.trim()) {
						this.filteredCategories = this.availableCategories;
					} else {
						const query = this.searchQuery.toLowerCase();
						this.filteredCategories = this.availableCategories.filter(category =>
							category.name.toLowerCase().includes(query) ||
							(category.label && category.label.toLowerCase().includes(query)) ||
							(category.path && category.path.toLowerCase().includes(query)) ||
							(category.fullPath && category.fullPath.toLowerCase().includes(query))
						);
					}
					this.isDropdownOpen = this.filteredCategories.length > 0;
				},

				selectCategory(category) {
					if (!this.isSelected(category.id)) {
						this.selectedCategories.push({
							id: category.id,
							name: category.name,
							label: category.label,
							path: category.path,
							fullPath: category.fullPath
						});
						// Update parent form data
						if (typeof productsConfig !== 'undefined') {
							productsConfig.formData.categoryIds = this.selectedCategories.map(c => c.id);
						}
					}
					this.closeDropdown();
				},

				removeCategory(categoryId) {
					this.selectedCategories = this.selectedCategories.filter(c => c.id !== categoryId);
					// Update parent form data
					if (typeof productsConfig !== 'undefined') {
						productsConfig.formData.categoryIds = this.selectedCategories.map(c => c.id);
					}
				},

				isSelected(categoryId) {
					return this.selectedCategories.some(c => c.id === categoryId);
				},

				// Method to sync with parent form
				setSelectedCategories(categories) {
					this.selectedCategories = categories || [];
				}
			}
			
			const productsConfig = {
				filters: {
					search: '',
					categoryMulti: [],
					statusMulti: []
				},
				pagination: {
					currentPage: 1,
					pageSize: 20,
					totalPages: 1,
					totalItems: 0
				},
				showDialog: false,
				showConfirmDialog: false,
				editingItem: null,
				itemToDelete: null,
				formData: {
					name: '',
					categoryIds: [],
					price: '',
					stock: '',
					status: 'active',
					description: ''
				},
				categorySelector: categorySelector,


				applyFilters() {
					const params = new URLSearchParams();
					if (this.filters.search) params.append('search', this.filters.search);
					if (this.filters.categoryMulti.length) {
						this.filters.categoryMulti.forEach(cat => params.append('categoryMulti', cat));
					}
					if (this.filters.statusMulti.length) {
						this.filters.statusMulti.forEach(status => params.append('statusMulti', status));
					}
					
					params.append('page', this.pagination.currentPage);
					params.append('limit', this.pagination.pageSize);
					
					htmx.ajax('GET', `/admin/products/list?${params.toString()}`, {
						target: '#products-table-container',
						swap: 'innerHTML'
					});
				},

				clearFilters() {
					this.filters = {
						search: '',
						categoryMulti: [],
						statusMulti: []
					};
					this.pagination.currentPage = 1;
					this.applyFilters();
				},

				goToPage(page) {
					if (page >= 1 && page <= this.pagination.totalPages) {
						this.pagination.currentPage = page;
						this.applyFilters();
					}
				},

				previousPage() {
					if (this.pagination.currentPage > 1) {
						this.pagination.currentPage--;
						this.applyFilters();
					}
				},

				nextPage() {
					if (this.pagination.currentPage < this.pagination.totalPages) {
						this.pagination.currentPage++;
						this.applyFilters();
					}
				},

				addItem() {
					this.resetForm();
					this.editingItem = null;
					this.showDialog = true;
					this.categorySelector = categorySelector;
					this.$nextTick(() => this.setupForm());
				},

				editItem(item) {
					this.resetForm();
					this.editingItem = item;
					this.formData = { 
						name: item.name || '',
						categoryIds: item.categories.map(({id}) => id),
						price: item.price || '',
						stock: item.stock || '',
						status: item.status || 'active',
						description: item.description || ''
					};
					this.showDialog = true;
					this.categorySelector = categorySelector;
					if(item.categories) this.categorySelector.selectedCategories = item.categories
				},

				resetForm() {
					console.log('resetForm')
					this.formData = {
						name: '',
						categoryIds: [],
						price: '',
						stock: '',
						status: 'active',
						description: ''
					};
					this.clearFilters();
					this.categorySelector.setSelectedCategories([]);
					// Reset category selector
				},

				deleteItem(item) {
					this.itemToDelete = item;
					this.showConfirmDialog = true;
				},

				closeDialog() {
					this.showDialog = false;
					this.resetForm();
					this.editingItem = null;
					console.log('closeDialog')
				},

				confirmAction() {
					this.categorySelector = null
					if (this.itemToDelete) {
						htmx.ajax('DELETE', `/admin/products/${this.itemToDelete.id}`, {
							target: '#products-table-container',
							swap: 'innerHTML'
						});
						this.itemToDelete = null;
					}
				},
				
				submitForm() {
					
					const method = this.editingItem ? 'PUT' : 'POST';
					const url = this.editingItem ? `/admin/products/${this.editingItem.id}` : '/admin/products';
					this.formData.categoryIds = this.categorySelector.selectedCategories.map(({id}) => id).join(',');
					htmx.ajax(method, url, {
						values: this.formData,
						target: '#products-table-container',
						swap: 'innerHTML'
					}).then(() => {
						console.log('Product submitted successfully');
						this.closeDialog();
					}).catch((error) => {
						console.error('Error submitting product:', error);
					});
				},

				init() {
					// Products config initialization
				}
			}
		</script>

		<div x-data="productsConfig">
			@ui.AddButton("Products Management")
			@ui.TableFilters()

			<!-- Products Table Container -->
			<div 
				hx-get="/admin/products/list"
				hx-trigger="load"
				hx-target="#products-table-container"
				hx-swap="innerHTML"
				id="products-table-container"
				class="overflow-hidden"
			>
				<!-- Loading state -->
				<div class="bg-white rounded-lg shadow p-8 text-center">
					<div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500 mx-auto"></div>
					<p class="mt-4 text-gray-600">Loading products...</p>
				</div>
			</div>
			
			<!-- Pagination -->
			@ui.Pagination()
			
			@ProductDialog()
			@ui.ConfirmDialog("Delete Product", "Are you sure you want to delete this product? This action cannot be undone.")
		</div>
	}
}

templ ProductDialog() {
	@ui.FormDialog("Product Details", "lg") {
		<form 
			id="product-form"
			class="space-y-4"
			hx-target="#products-table-container"
			hx-swap="innerHTML"
			@htmx:after-request="if($event.detail.successful) closeDialog()"
		>
			<input type="hidden" name="Id" x-bind:value="editingItem ? editingItem.id : ''" />
			
			<div>
				<label for="product-name" class="block text-sm font-medium text-gray-700 mb-1">Product Name</label>
				<input 
					type="text" 
					id="product-name" 
					name="Name"
					x-model="formData.name"
					required
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
				/>
			</div>
			
			<!-- Categories Multi-Select Component -->
			<div x-data="categorySelector" class="space-y-3 relative">
				<label class="block text-sm font-medium text-gray-700">Product Categories</label>
				
				<!-- Selected Categories Display -->
				<div class="min-h-[2.5rem] p-3 border border-gray-300 rounded-lg bg-gray-50">
					<div x-show="selectedCategories.length === 0" class="text-gray-500 text-sm">
						No categories selected
					</div>
					<div x-show="selectedCategories.length > 0" class="flex flex-wrap gap-2">
						<template x-for="category in selectedCategories" :key="category.id">
							<span class="inline-flex items-center gap-1 px-2 py-1 bg-blue-100 text-blue-800 rounded-md text-sm">
								<span x-text="category.fullPath || category.name"></span>
								<button 
									type="button" 
									@click="removeCategory(category.id)"
									class="hover:bg-blue-200 rounded-full p-0.5"
								>
									<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
									</svg>
								</button>
							</span>
						</template>
					</div>
				</div>

				<!-- Search Input -->
				<div class="relative">
					<input
						id="category-prod-search"
						type="text"
						x-model="searchQuery"
						@click="openDropdown()"
						@input="filterCategories()"
						@keydown.escape="closeDropdown()"
						placeholder="Search and select categories..."
						class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
					/>
					<div class="absolute inset-y-0 right-0 flex items-center pr-3">
						<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
						</svg>
					</div>
				</div>

				<!-- Dropdown Menu -->
				<div 
					x-show="isDropdownOpen && filteredCategories.length > 0"
					x-transition:enter="transition ease-out duration-100"
					x-transition:enter-start="opacity-0 scale-95"
					x-transition:enter-end="opacity-100 scale-100"
					x-transition:leave="transition ease-in duration-75"
					x-transition:leave-start="opacity-100 scale-100"
					x-transition:leave-end="opacity-0 scale-95"
					@click.outside="closeDropdown()"
					class="absolute w-full z-10 bg-white border border-gray-300 rounded-lg shadow-lg max-h-48 overflow-auto"
				>
					<template x-for="category in filteredCategories" :key="category.id">
						<div
							@click="selectCategory(category)"
							:class="isSelected(category.id) ? 'bg-blue-50 text-blue-900' : 'hover:bg-gray-50'"
							class="px-3 py-2 cursor-pointer border-b border-gray-100 last:border-b-0"
						>
							<div class="flex items-center justify-between">
								<div class="flex-1">
									<div class="font-medium" x-text="category.name"></div>
									<div x-show="category.fullPath" class="text-xs text-gray-500" x-text="category.fullPath"></div>
								</div>
								<div x-show="isSelected(category.id)" class="text-blue-600">
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
									</svg>
								</div>
							</div>
						</div>
					</template>
				</div>

			</div>
			
			<div>
				<label for="product-price" class="block text-sm font-medium text-gray-700 mb-1">Price</label>
				<div class="relative">
					<span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-500">$</span>
					<input 
						type="number" 
						id="product-price" 
						name="Price"
						x-model="formData.price"
						step="0.01"
						min="0"
						required
						class="w-full pl-8 pr-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
					/>
				</div>
			</div>
			
			<div>
				<label for="product-stock" class="block text-sm font-medium text-gray-700 mb-1">Stock Quantity</label>
				<input 
					type="number" 
					id="product-stock" 
					name="Stock"
					x-model="formData.stock"
					min="0"
					required
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
				/>
			</div>
			
			<div>
				<label for="product-status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
				<select 
					id="product-status" 
					name="Status"
					x-model="formData.status"
					required
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
				>
					<option value="">Select status</option>
					<option value="active">Active</option>
					<option value="inactive">Inactive</option>
					<option value="out_of_stock">Out of Stock</option>
				</select>
			</div>
			
			<div>
				<label for="product-description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
				<textarea 
					id="product-description" 
					name="Description"
					x-model="formData.description"
					rows="4"
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
				></textarea>
			</div>
			
			<div class="flex justify-end space-x-3 pt-4">
				<button 
					type="button" 
					@click="closeDialog()"
					class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 border border-gray-300 rounded-md hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
				>
					Cancel
				</button>
				<button 
					type="button"
					@click="submitForm()"
					class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
				>
					<span x-text="editingItem ? 'Update Product' : 'Create Product'"></span>
				</button>
			</div>
		</form>
	}
} 