package pages

import (
	"main/web/admin/view"
	"main/web/admin/view/ui"
)

templ Settings() {
	@view.AdminLayout() {
		<div x-data="settingsPage()">
			<div class="mb-6">
				<h2 class="text-2xl font-bold text-gray-900">Settings</h2>
				<p class="text-gray-600">Manage your website configuration and settings</p>
			</div>
			
			@ui.Tabs("general")
			
			<!-- General Tab Content -->
			<div x-show="activeTab === 'general'" x-transition>
				@GeneralSettings()
			</div>
			
			<!-- Translation Tab Content -->
			<div x-show="activeTab === 'translation'" x-transition>
				@TranslationSettings()
			</div>
			
			<!-- Payments Tab Content -->
			<div x-show="activeTab === 'payments'" x-transition>
				@PaymentsSettings()
			</div>
			
			@TranslationDialog()
			
			@ui.ConfirmDialog("Delete Translation", "Are you sure you want to delete this translation? This action cannot be undone.")
		</div>
		
		<script>
			function settingsPage() {
				return {
					activeTab: 'general',
					showDialog: false,
					showConfirmDialog: false,
					editingItem: null,
					itemToDelete: null,
					currentLanguage: 'en',
					formData: {
						key: '',
						value: '',
						language: 'en'
					},

					addTranslation() {
						this.editingItem = null;
						this.formData = { key: '', value: '', language: this.currentLanguage };
						this.showDialog = true;
					},

					editTranslation(item) {
						console.log('editTranslation called with:', item);
						this.editingItem = item;
						this.formData = { ...item };
						this.showDialog = true;
					},

					submitTranslation() {
						const form = document.querySelector('#translation-form');
						const formData = new FormData(form);
						
						// Determine method and URL based on whether we're editing
						const method = this.editingItem ? 'PUT' : 'POST';
						const url = this.editingItem 
							? `/admin/settings/translation/${this.editingItem.id}`
							: '/admin/settings/translation';
							
						console.log('Submitting translation:', { method, url, formData: Object.fromEntries(formData) });
						
						htmx.ajax(method, url, {
							values: Object.fromEntries(formData),
							target: '#translations-table-container',
							swap: 'innerHTML'
						}).then(() => {
							console.log('Translation submitted successfully');
							this.closeDialog();
						}).catch((error) => {
							console.error('Error submitting translation:', error);
						});
					},

					deleteTranslation(item) {
						this.itemToDelete = item;
						this.showConfirmDialog = true;
					},

					confirmAction() {
						if (this.itemToDelete) {
							htmx.ajax('DELETE', `/admin/settings/translation/${this.itemToDelete.id}`, {
								target: '#translations-table-container',
								swap: 'innerHTML'
							});
							this.itemToDelete = null;
						}
					},

					loadTranslations() {
						const params = new URLSearchParams();
						if (this.currentLanguage) params.append('language', this.currentLanguage);
						
						htmx.ajax('GET', `/admin/settings/translation/list?${params.toString()}`, {
							target: '#translations-table-container',
							swap: 'innerHTML'
						});
					},

					closeDialog() {
						this.showDialog = false;
						this.resetForm();
						this.editingItem = null;
					},

					resetForm() {
						this.formData = {
							key: '',
							value: '',
							language: this.currentLanguage
						};
					}
				}
			}
		</script>
	}
}

templ GeneralSettings() {
	<div 
		hx-get="/admin/settings/general"
		hx-trigger="load"
		hx-target="#general-settings-container"
		hx-swap="innerHTML"
		id="general-settings-container"
	>
		<!-- Loading state -->
		<div class="bg-white rounded-lg shadow p-6 text-center">
			<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500 mx-auto"></div>
			<p class="mt-2 text-gray-600">Loading settings...</p>
		</div>
	</div>
}

templ TranslationSettings() {
	<div class="space-y-6">
		<!-- Language Selector -->
		<div class="bg-white rounded-lg shadow p-6">
			<div class="flex justify-between items-center mb-4">
				<h3 class="text-lg font-medium text-gray-900">Manage Translations</h3>
				<button 
					@click="addTranslation()"
					class="px-4 py-2 rounded-md text-white font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
					style="background-color: #f4cc1d; color: #000755;"
				>
					Add Translation
				</button>
			</div>
			
			<div class="mb-4">
				<label class="block text-sm font-medium text-gray-700 mb-2">Select Language</label>
				<select 
					x-model="currentLanguage"
					@change="loadTranslations()"
					class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
				>
					<option value="en">English (EN)</option>
					<option value="ru">Russian (RU)</option>
					<option value="ge">Georgian (GE)</option>
				</select>
			</div>
		</div>
		
		<!-- Translations Table Container -->
		<div 
			hx-get="/admin/settings/translation/list?language=en"
			hx-trigger="load"
			hx-target="#translations-table-container"
			hx-swap="innerHTML"
			id="translations-table-container"
		>
			<!-- Loading state -->
			<div class="bg-white rounded-lg shadow p-8 text-center">
				<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500 mx-auto"></div>
				<p class="mt-2 text-gray-600">Loading translations...</p>
			</div>
		</div>
	</div>
}

templ PaymentsSettings() {
	<div class="bg-white rounded-lg shadow p-6">
		<div class="text-center py-12">
			<svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
			</svg>
			<h3 class="text-xl font-medium text-gray-900 mb-2">Payment Settings</h3>
			<p class="text-gray-500 mb-8">Payment configuration will be implemented soon</p>
			<div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 max-w-md mx-auto">
				<div class="flex items-center">
					<svg class="w-5 h-5 text-yellow-400 mr-3" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
					</svg>
					<p class="text-sm text-yellow-800">
						Payment gateway integration coming soon.
					</p>
				</div>
			</div>
		</div>
	</div>
}

templ TranslationDialog() {
	@ui.FormDialog("Translation", "md") {
		<form 
			id="translation-form"
			class="space-y-4"
			@submit.prevent="submitTranslation()"
		>
			<input type="hidden" name="Id" x-bind:value="editingItem ? editingItem.id : ''" />
			
			<div>
				<label for="translation-key" class="block text-sm font-medium text-gray-700 mb-1">Key</label>
				<input 
					type="text" 
					id="translation-key"
					name="Key"
					x-model="formData.key"
					required
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
				/>
			</div>
			
			<div>
				<label for="translation-value" class="block text-sm font-medium text-gray-700 mb-1">Value</label>
				<textarea 
					id="translation-value"
					name="Value"
					x-model="formData.value"
					rows="3"
					required
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
				></textarea>
			</div>
			
			<div>
				<label for="translation-language" class="block text-sm font-medium text-gray-700 mb-1">Language</label>
				<select 
					id="translation-language"
					name="Language"
					x-model="formData.language"
					required
					class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
				>
					<option value="">Select Language</option>
					<option value="en">English</option>
					<option value="ge">Georgian</option>
					<option value="ru">Russian</option>
				</select>
			</div>

			<div class="flex justify-end space-x-3 pt-4">
				<button 
					type="button" 
					@click="closeDialog()"
					class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 border border-gray-300 rounded-md hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
				>
					Cancel
				</button>
				<button 
					type="submit"
					class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
				>
					<span x-text="editingItem ? 'Update Translation' : 'Create Translation'"></span>
				</button>
			</div>
		</form>
	}
} 