package components

import (
	"main/internal/models"
	"fmt"
)

templ CategoriesTree(categories []models.Category) {
	<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden" id="categories-tree">
		<div class="bg-gradient-to-r from-indigo-50 to-blue-50 px-6 py-4 border-b border-gray-200">
			<div class="flex items-center justify-between">
				<div class="flex items-center space-x-3">
					<div class="p-2 bg-indigo-100 rounded-lg">
						<svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v0H8v0z"></path>
						</svg>
					</div>
					<div>
						<h3 class="text-lg font-semibold text-gray-900">Category Tree</h3>
						<p class="text-sm text-gray-600">Hierarchical view of all categories</p>
					</div>
				</div>
				<div class="flex items-center space-x-2">
					<button 
						type="button"
						class="px-3 py-1.5 text-xs font-medium text-gray-600 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500"
						onclick="expandAllCategories()"
					>
						Expand All
					</button>
					<button 
						type="button"
						class="px-3 py-1.5 text-xs font-medium text-gray-600 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500"
						onclick="collapseAllCategories()"
					>
						Collapse All
					</button>
				</div>
			</div>
		</div>
		
		<div class="p-6">
			if len(categories) == 0 {
				<div class="text-center py-12">
					<div class="flex flex-col items-center">
						<div class="p-3 bg-gray-100 rounded-full mb-4">
							<svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v0H8v0z"></path>
							</svg>
						</div>
						<h3 class="text-lg font-medium text-gray-900 mb-2">No categories found</h3>
						<p class="text-sm text-gray-500 mb-6">Get started by creating your first category</p>
						<button 
							type="button"
							class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
							onclick="categoriesConfig.openDialog()"
						>
							<svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
							</svg>
							Add First Category
						</button>
					</div>
				</div>
			} else {
				<div class="space-y-1">
					for _, category := range categories {
						@CategoryTreeNode(category, 0)
					}
				</div>
			}
		</div>
	</div>
}

templ CategoryTreeNode(category models.Category, depth int) {
	<div class="category-node group" data-category-id={ fmt.Sprintf("%d", category.ID) }>
		<div class="flex items-center justify-between p-3 rounded-lg hover:bg-gray-50 transition-colors duration-150" style={ fmt.Sprintf("margin-left: %dpx", depth*24) }>
			<div class="flex items-center space-x-3 flex-1 min-w-0">
				<!-- Expand/Collapse Button -->
				if len(category.Children) > 0 {
					<button 
						type="button"
						class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-md text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors duration-150"
						@click={ fmt.Sprintf("toggleCategory(%d)", category.ID) }
					>
						<svg class="w-4 h-4 transform transition-transform duration-200 category-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
						</svg>
					</button>
				} else {
					<div class="w-6 h-6 flex items-center justify-center">
						<div class="w-1 h-1 bg-gray-300 rounded-full"></div>
					</div>
				}
				
				<!-- Category Icon -->
				<div class="flex-shrink-0">
					if len(category.Children) > 0 {
						<div class="w-8 h-8 bg-gradient-to-br from-blue-100 to-indigo-100 rounded-lg flex items-center justify-center">
							<svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
								<path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"></path>
							</svg>
						</div>
					} else {
						<div class="w-8 h-8 bg-gradient-to-br from-gray-100 to-gray-200 rounded-lg flex items-center justify-center">
							<svg class="w-4 h-4 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-5L9 2H4z" clip-rule="evenodd"></path>
							</svg>
						</div>
					}
				</div>
				
				<!-- Category Info -->
				<div class="flex-1 min-w-0">
					<div class="flex items-center space-x-3">
						<div class="min-w-0 flex-1">
							<div class="flex items-center space-x-2">
								<h4 class="text-sm font-medium text-gray-900 truncate">{ category.Name }</h4>
								if !category.IsActive {
									<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
										<svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
										</svg>
										Inactive
									</span>
								}
							</div>
							if category.Description != "" {
								<p class="text-xs text-gray-500 mt-1 truncate">{ category.Description }</p>
							}
							<div class="flex items-center space-x-4 mt-1">
								<span class="text-xs text-gray-400">ID: { fmt.Sprintf("%d", category.ID) }</span>
								<span class="text-xs text-gray-400">Slug: { category.Slug }</span>
								if category.SortOrder > 0 {
									<span class="text-xs text-gray-400">Order: { fmt.Sprintf("%d", category.SortOrder) }</span>
								}
							</div>
						</div>
					</div>
				</div>
			</div>
			
			<!-- Action Buttons -->
			<div class="flex items-center space-x-1 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
				<button
					type="button"
					class="p-2 text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors duration-150"
					@click={ func() string {
						parentId := "null"
						if category.ParentID != nil {
							parentId = fmt.Sprintf("%d", *category.ParentID)
						}
						return fmt.Sprintf("editCategory({id: %d, name: %q, slug: %q, description: %q, parentId: %s, sortOrder: %d, isActive: %t})", category.ID, category.Name, category.Slug, category.Description, parentId, category.SortOrder, category.IsActive)
					}() }
					title="Edit category"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
					</svg>
				</button>
				
				<button
					type="button"
					class="p-2 text-gray-400 hover:text-green-600 hover:bg-green-50 rounded-lg transition-colors duration-150"
					@click={ fmt.Sprintf("addSubCategory(%d)", category.ID) }
					title="Add subcategory"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
					</svg>
				</button>
				
				<button
					type="button"
					class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors duration-150"
					@click={ fmt.Sprintf("deleteCategory({id: %d, name: %q})", category.ID, category.Name) }
					title="Delete category"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
					</svg>
				</button>
			</div>
		</div>
		
		<!-- Children Container -->
		if len(category.Children) > 0 {
			<div class="category-children transition-all duration-300" id={ fmt.Sprintf("children-%d", category.ID) }>
				for _, child := range category.Children {
					@CategoryTreeNode(child, depth+1)
				}
			</div>
		}
	</div>
} 