package components

import (
	"main/internal/models"
	"fmt"
	"strconv"
)

script log(categories []models.Category) {
	console.log(categories)
}

templ CategoriesTree(categories []models.Category) {
	@log(categories)
	<div class="bg-white rounded-lg shadow overflow-hidden" id="categories-tree">
		if len(categories) == 0 {
			<div class="p-8 text-center">
				<div class="flex flex-col items-center">
					<svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2v0"></path>
					</svg>
					<p class="text-lg font-medium text-gray-900 mb-2">No categories found</p>
					<p class="text-sm text-gray-500">Get started by adding your first category</p>
				</div>
			</div>
		} else {
			<div class="p-6">
				@renderCategoryTree(buildCategoryTree(categories), 0)
			</div>
		}
	</div>
}

templ renderCategoryTree(categories []models.Category, level int) {
	for _, category := range categories {
		@CategoryTreeNode(category, level)
	}
}

templ CategoryTreeNode(category models.Category, level int) {
	<div class="category-node" data-category-id={ strconv.Itoa(int(category.ID)) }>
		<div class={ fmt.Sprintf("flex items-center py-2 hover:bg-gray-50 rounded-lg transition-colors duration-150 pl-%d", level*6) }>
			<!-- Expand/Collapse Button -->
			if len(category.Children) > 0 {
				<button 
					type="button" 
					class="expand-toggle mr-2 p-1 hover:bg-gray-200 rounded transition-colors duration-150"
					@click={ fmt.Sprintf("toggleNode(%d)", category.ID) }
				>
					<svg class="w-4 h-4 transform transition-transform duration-150 expand-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</button>
			} else {
				<div class="w-6 h-6 mr-2"></div>
			}
			
			<!-- Category Icon based on type -->
			<div class="mr-3">
				@getCategoryIcon(category.Type)
			</div>
			
			<!-- Category Info -->
			<div class="flex-1 min-w-0">
				<div class="flex items-center space-x-2">
					<h3 class="text-sm font-medium text-gray-900 truncate">{ category.Name }</h3>
					if category.Label != "" {
						<span class="text-xs text-gray-500 truncate">({ category.Label })</span>
					}
					<span class={ fmt.Sprintf("inline-flex px-2 py-0.5 rounded text-xs font-medium %s", getTypeClass(category.Type)) }>
						{ category.Type }
					</span>
					<span class="text-xs text-gray-400">Level { strconv.Itoa(category.Level) }</span>
					if !category.IsActive {
						<span class="inline-flex px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
							Inactive
						</span>
					}
				</div>
				if category.Description != "" {
					<p class="text-xs text-gray-500 mt-1 truncate">{ category.Description }</p>
				}
			</div>
			
			<!-- Action Buttons -->
			<div class="flex items-center space-x-2 ml-4">
				<!-- Add Child Button -->
				<button 
					type="button"
					@click={ fmt.Sprintf("addChildCategory(%d, '%s')", category.ID, category.Name) }
					class="text-green-600 hover:text-green-800 text-xs font-medium p-1 hover:bg-green-50 rounded transition-colors duration-150"
					title="Add child category"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
					</svg>
				</button>
				
				<!-- Edit Button -->
				<button 
					type="button"
					@click={ fmt.Sprintf("editCategory({id: %d, name: %q, label: %q, description: %q, parentId: %s, sortOrder: %d, isActive: %t, type: %q, level: %d, slug: %q, path: %q})", 
						category.ID, 
						category.Name, 
						category.Label, 
						category.Description, 
						formatParentID(category.ParentID), 
						category.SortOrder, 
						category.IsActive,
						category.Type,
						category.Level,
						category.Slug,
						category.Path) }
					class="text-blue-600 hover:text-blue-800 text-xs font-medium p-1 hover:bg-blue-50 rounded transition-colors duration-150"
					title="Edit category"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
					</svg>
				</button>
				
				<!-- Delete Button -->
				<button 
					type="button"
					@click={ fmt.Sprintf("deleteCategory({id: %d, name: %q})", category.ID, category.Name) }
					class="text-red-600 hover:text-red-800 text-xs font-medium p-1 hover:bg-red-50 rounded transition-colors duration-150"
					title="Delete category"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
					</svg>
				</button>
			</div>
		</div>
		
		<!-- Children Container -->
		if len(category.Children) > 0 {
			<div class={ fmt.Sprintf("children-container ml-6 border-l border-gray-200") } id={ fmt.Sprintf("children-%d", category.ID) }>
				@renderCategoryTree(category.Children, level+1)
			</div>
		}
	</div>
}

templ getCategoryIcon(categoryType string) {
	switch categoryType {
		case "vehicle":
			<svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a2 2 0 012-2h2a2 2 0 012 2v3a3 3 0 01-3 3z"></path>
			</svg>
		case "maker":
			<svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
			</svg>
		case "model":
			<svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
			</svg>
		case "type":
			<svg class="w-5 h-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
			</svg>
		case "parts":
			<svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
			</svg>
		default:
			<svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
			</svg>
	}
}

func getTypeClass(categoryType string) string {
	switch categoryType {
	case "vehicle":
		return "bg-blue-100 text-blue-800"
	case "maker":
		return "bg-purple-100 text-purple-800"
	case "model":
		return "bg-green-100 text-green-800"
	case "type":
		return "bg-yellow-100 text-yellow-800"
	case "parts":
		return "bg-red-100 text-red-800"
	default:
		return "bg-gray-100 text-gray-800"
	}
}

func formatParentID(parentID *uint) string {
	if parentID == nil {
		return "null"
	}
	return fmt.Sprintf("%d", *parentID)
}

// buildCategoryTree organizes categories into a hierarchical structure
func buildCategoryTree(categories []models.Category) []models.Category {
	// Create a map for quick lookup
	categoryMap := make(map[uint]*models.Category)
	for i := range categories {
		categoryMap[categories[i].ID] = &categories[i]
		categories[i].Children = []models.Category{} // Initialize children slice
	}

	// Build the tree
	var rootCategories []models.Category
	for i := range categories {
		if categories[i].ParentID == nil {
			// This is a root category
			rootCategories = append(rootCategories, categories[i])
		} else {
			// This is a child category
			parent := categoryMap[*categories[i].ParentID]
			if parent != nil {
				parent.Children = append(parent.Children, categories[i])
			}
		}
	}

	return rootCategories
} 