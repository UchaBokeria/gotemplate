package pages

import (
	"main/web/app/types"
	"main/web/app/view" 
	"main/web/app/view/components"
)

templ Auth(webconfig types.WebConfig) {
    @view.Index(webconfig) {
        @components.Navigation()
        
        <main class="min-h-screen bg-gray-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
            <div class="max-w-md w-full space-y-8">
                @AuthCard()
            </div>
        </main>
    }
}

templ AuthCard() {
    <div class="bg-white rounded-xl shadow-lg p-8" x-data="{ activeTab: 'login' }">
        <!-- Logo and Header -->
        <div class="text-center mb-8">
            <div class="w-20 h-20 mx-auto rounded-2xl flex items-center justify-center shadow-xl mb-6 overflow-hidden transition-transform duration-200 hover:scale-105" style="background: linear-gradient(135deg, #f4cc1d 0%, #e6b800 100%); border: 3px solid rgba(0, 7, 85, 0.1);">
                <img src="/assets/images/logo.png" alt="Alfashop Logo" class="w-16 h-16 object-contain filter drop-shadow-md" />
            </div>
            <h2 class="text-3xl font-bold tracking-tight" style="color: #000755;">Welcome to Alfashop</h2>
            <p class="text-gray-600 mt-2 font-medium">Your trusted exclusive auto parts partner</p>
        </div>

        <!-- Tab Navigation -->
        <div class="flex mb-6 bg-gray-100 rounded-lg p-1">
            <button 
                @click="activeTab = 'login'" 
                :class="activeTab === 'login' ? 'text-blue-900 shadow-sm' : 'text-gray-600'"
                class="flex-1 py-2 px-4 text-center font-medium text-sm rounded-md transition-all duration-200"
                :style="activeTab === 'login' ? 'background-color: #f4cc1d; color: #000755;' : ''"
            >
                Login
            </button>
            <button 
                @click="activeTab = 'register'" 
                :class="activeTab === 'register' ? 'text-blue-900 shadow-sm' : 'text-gray-600'"
                class="flex-1 py-2 px-4 text-center font-medium text-sm rounded-md transition-all duration-200"
                :style="activeTab === 'register' ? 'background-color: #f4cc1d; color: #000755;' : ''"
            >
                Register
            </button>
        </div>

        <!-- Login Form -->
        <div x-show="activeTab === 'login'" x-transition class="space-y-6">
            <form 
                hx-post="/auth/login" 
                hx-target="#login-messages" 
                hx-swap="innerHTML"
                class="space-y-6"
            >
                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
                    <input 
                        id="email" 
                        name="Email" 
                        type="email" 
                        required 
                        class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md text-sm shadow-sm placeholder-gray-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500"
                    />
                </div>
                
                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700">Password</label>
                    <input 
                        id="password" 
                        name="Password" 
                        type="password" 
                        required 
                        class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md text-sm shadow-sm placeholder-gray-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500"
                    />
                </div>
                
                <div class="flex items-center">
                    <input 
                        id="remember-me" 
                        name="Remember" 
                        type="checkbox" 
                        class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                    />
                    <label for="remember-me" class="ml-2 block text-sm text-gray-900">Remember me</label>
                </div>
                
                <button 
                    type="submit" 
                    class="w-full py-3 px-4 text-blue-900 font-semibold rounded-md shadow-sm hover:shadow-md transition-all duration-200 hover:scale-105"
                    style="background-color: #f4cc1d; color: #000755;"
                >
                    Sign In
                </button>
            </form>
        </div>

        <!-- Register Form -->
        <div x-show="activeTab === 'register'" x-transition class="space-y-6">
            <form 
                hx-post="/auth/register" 
                hx-target="#register-messages" 
                hx-swap="innerHTML"
                class="space-y-6"
            >
                <div>
                    <label for="register-email" class="block text-sm font-medium text-gray-700">Email</label>
                    <input 
                        id="register-email" 
                        name="Email" 
                        type="email" 
                        required 
                        class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md text-sm shadow-sm placeholder-gray-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500"
                    />
                </div>
                
                <div>
                    <label for="register-password" class="block text-sm font-medium text-gray-700">Password</label>
                    <input 
                        id="register-password" 
                        name="Password" 
                        type="password" 
                        required 
                        class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md text-sm shadow-sm placeholder-gray-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500"
                    />
                </div>
                
                <div>
                    <label for="confirm-password" class="block text-sm font-medium text-gray-700">Confirm Password</label>
                    <input 
                        id="confirm-password" 
                        name="ConfirmPassword" 
                        type="password" 
                        required 
                        class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md text-sm shadow-sm placeholder-gray-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500"
                    />
                </div>
                
                <div class="flex items-center">
                    <input 
                        type="checkbox" 
                        id="terms" 
                        required
                        class="h-4 w-4 rounded border-gray-300 focus:ring-yellow-500"
                        style="accent-color: #f4cc1d;"
                    />
                    <label for="terms" class="ml-2 block text-sm text-gray-700">
                        I agree to the <a href="#" class="hover:underline" style="color: #000755;">Terms and Conditions</a>
                    </label>
                </div>
                
                <button 
                    type="submit" 
                    :disabled="password && confirmPassword && password !== confirmPassword"
                    :class="password && confirmPassword && password !== confirmPassword ? 'opacity-50 cursor-not-allowed' : ''"
                    class="w-full py-3 px-4 text-blue-900 font-semibold rounded-md shadow-sm hover:shadow-md transition-all duration-200 hover:scale-105"
                    style="background-color: #f4cc1d; color: #000755;"
                >
                    Create Account
                </button>
            </form>
        </div>

        <!-- Additional Info -->
        <div class="mt-8 text-center">
            <p class="text-sm text-gray-600">
                Need help? <a href="/about" class="hover:underline" style="color: #000755;">Contact our support team</a>
            </p>
        </div>
    </div>

    <!-- Alpine.js Functions -->
    <script>
        function handleLogin(event) {
            const formData = new FormData(event.target);
            const email = formData.get('email');
            const password = formData.get('password');
            const rememberMe = formData.get('remember') === 'on';
            
            if (!email || !password) {
                alert('Please fill in all fields');
                return;
            }
            
            Alpine.store('auth').login({ email, password, rememberMe });
        }

        function handleRegister(event) {
            const formData = new FormData(event.target);
            const email = formData.get('email');
            const password = formData.get('password');
            const confirmPassword = formData.get('confirm_password');
            
            if (!email || !password || !confirmPassword) {
                alert('Please fill in all fields');
                return;
            }
            
            if (password !== confirmPassword) {
                alert('Passwords do not match!');
                return;
            }
            
            console.log('Registration attempt:', { email, password });
            alert('Registration successful! Please login with your credentials.');
        }
    </script>
}
