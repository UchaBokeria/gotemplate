package pages

import (
	"main/web/app/types"
	"main/web/app/view"
	"main/web/app/view/components"
)

templ Products(webconfig types.WebConfig) {
    @view.Index(webconfig) {
        @components.Navigation()
        
        <main class="min-h-screen bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                <!-- Page Header -->
                <div class="mb-8">
                    <h1 class="text-3xl font-bold mb-2" style="color: #000755;">Premium Auto Parts & Filters</h1>
                    <p class="text-gray-600">Exclusively imported premium automotive parts from world-leading manufacturers</p>
                </div>
                
                <div class="lg:grid lg:grid-cols-4 lg:gap-8" x-data="productStore()">
                    <!-- Filters Sidebar -->
                    <div class="lg:col-span-1">
                        @FilterSidebar()
                    </div>
                    
                    <!-- Products Grid -->
                    <div class="lg:col-span-3 mt-8 lg:mt-0">
                        @ProductsHeader()
                        @ProductsGrid()
                    </div>
                </div>
            </div>
        </main>
    }
}

templ FilterSidebar() {
    <div class="bg-white rounded-lg shadow-sm p-6 sticky top-24">
        <h3 class="text-lg font-semibold mb-4" style="color: #000755;">Filters</h3>
        
        <!-- Search -->
        <div class="mb-6">
            <label for="search" class="block text-sm font-medium text-gray-700 mb-2">Search Parts</label>
            <input 
                type="text" 
                id="search" 
                x-model="filters.search"
                @input.debounce.500ms="applyFilters()"
                placeholder="Search by part name or number..."
                class="w-full px-3 py-2 border border-gray-300 rounded-md form-input focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent"
            />
        </div>
        
        <!-- Categories -->
        <div class="mb-6">
            <h4 class="font-medium text-gray-900 mb-3">Categories</h4>
            <div class="space-y-2" 
                 hx-get="/products/categories"
                 hx-trigger="load"
                 hx-target="this"
                 hx-swap="innerHTML">
                <!-- Loading categories... -->
                <div class="text-sm text-gray-500">Loading categories...</div>
            </div>
        </div>
        
        <!-- Price Range -->
        <div class="mb-6">
            <h4 class="font-medium text-gray-900 mb-3">Price Range</h4>
            <div class="space-y-2">
                <label class="flex items-center">
                    <input type="radio" x-model="filters.priceRange" value="" @change="applyFilters()" name="price" class="text-yellow-500 focus:ring-yellow-500" style="accent-color: #f4cc1d;" />
                    <span class="ml-2 text-sm text-gray-700">All Prices</span>
                </label>
                <label class="flex items-center">
                    <input type="radio" x-model="filters.priceRange" value="0-25" @change="applyFilters()" name="price" class="text-yellow-500 focus:ring-yellow-500" style="accent-color: #f4cc1d;" />
                    <span class="ml-2 text-sm text-gray-700">$0 - $25</span>
                </label>
                <label class="flex items-center">
                    <input type="radio" x-model="filters.priceRange" value="25-50" @change="applyFilters()" name="price" class="text-yellow-500 focus:ring-yellow-500" style="accent-color: #f4cc1d;" />
                    <span class="ml-2 text-sm text-gray-700">$25 - $50</span>
                </label>
                <label class="flex items-center">
                    <input type="radio" x-model="filters.priceRange" value="50-100" @change="applyFilters()" name="price" class="text-yellow-500 focus:ring-yellow-500" style="accent-color: #f4cc1d;" />
                    <span class="ml-2 text-sm text-gray-700">$50 - $100</span>
                </label>
                <label class="flex items-center">
                    <input type="radio" x-model="filters.priceRange" value="100+" @change="applyFilters()" name="price" class="text-yellow-500 focus:ring-yellow-500" style="accent-color: #f4cc1d;" />
                    <span class="ml-2 text-sm text-gray-700">$100+</span>
                </label>
            </div>
        </div>
        
        <!-- Clear Filters -->
        <button 
            @click="clearFilters()"
            class="w-full px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
        >
            Clear All Filters
        </button>
    </div>
}

templ ProductsHeader() {
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
        <div class="mb-4 sm:mb-0">
            <p class="text-sm text-gray-600" x-text="`Showing ${totalCount} results`">Loading...</p>
        </div>
        
        <div class="flex items-center space-x-4">
            <!-- Sort Dropdown -->
            <div class="relative">
                <select x-model="sortBy" @change="applyFilters()" class="px-3 py-2 border border-gray-300 rounded-md form-input focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent">
                    <option value="newest">Newest First</option>
                    <option value="name">Sort by Name</option>
                    <option value="price-low">Price: Low to High</option>
                    <option value="price-high">Price: High to Low</option>
                </select>
            </div>
            
            <!-- View Toggle -->
            <div class="flex border border-gray-300 rounded-md">
                <button 
                    @click="viewMode = 'grid'"
                    :class="viewMode === 'grid' ? 'text-blue-900' : 'text-gray-400'"
                    :style="viewMode === 'grid' ? 'background-color: #f4cc1d; color: #000755;' : ''"
                    class="p-2 rounded-l-md transition-colors"
                >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                    </svg>
                </button>
                <button 
                    @click="viewMode = 'list'"
                    :class="viewMode === 'list' ? 'text-blue-900' : 'text-gray-400'"
                    :style="viewMode === 'list' ? 'background-color: #f4cc1d; color: #000755;' : ''"
                    class="p-2 rounded-r-md transition-colors"
                >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>
}

templ ProductsGrid() {
    <div>
        <!-- Products Container -->
        <div 
            :class="viewMode === 'grid' ? 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6' : 'space-y-4'"
            id="products-container"
            hx-get="/products"
            hx-trigger="load"
            hx-target="#products-container"
            hx-swap="innerHTML"
        >
            <!-- Loading State -->
            <div class="col-span-full flex justify-center py-12">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500"></div>
            </div>
        </div>
        
        <!-- Infinite Scroll Trigger -->
        <div 
            id="infinite-scroll-trigger"
            x-show="hasMore && !loading"
            x-intersect="loadMore()"
            class="h-20 flex items-center justify-center"
        >
            <div x-show="loading" class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-500"></div>
        </div>
        
        <!-- End of Results -->
        <div x-show="!hasMore && products.length > 0" class="text-center py-8">
            <p class="text-gray-500">You've reached the end of results</p>
        </div>
    </div>

    <!-- Alpine.js Store -->
    <script>
        function productStore() {
            return {
                viewMode: 'grid',
                sortBy: 'newest',
                currentPage: 1,
                totalCount: 0,
                hasMore: true,
                loading: false,
                products: [],
                filters: {
                    search: '',
                    category: '',
                    priceRange: ''
                },
                
                init() {
                    this.loadProducts(true);
                },
                
                buildQueryParams() {
                    const params = new URLSearchParams();
                    params.append('page', this.currentPage.toString());
                    params.append('limit', '12');
                    params.append('sort_by', this.sortBy);
                    
                    if (this.filters.search) params.append('search', this.filters.search);
                    if (this.filters.category) params.append('category', this.filters.category);
                    
                    if (this.filters.priceRange) {
                        const [min, max] = this.filters.priceRange.split('-');
                        if (min) params.append('min_price', min);
                        if (max && max !== '+') params.append('max_price', max);
                        if (max === '+') params.append('min_price', min);
                    }
                    
                    return params.toString();
                },
                
                loadProducts(reset = false) {
                    if (this.loading) return;
                    
                    this.loading = true;
                    if (reset) {
                        this.currentPage = 1;
                        this.products = [];
                    }
                    
                    const queryParams = this.buildQueryParams();
                    
                    htmx.ajax('GET', `/products?${queryParams}`, {
                        target: reset ? '#products-container' : '#products-container',
                        swap: reset ? 'innerHTML' : 'beforeend'
                    }).then(() => {
                        this.updatePaginationInfo();
                        this.loading = false;
                    });
                },
                
                updatePaginationInfo() {
                    const paginationInfo = document.getElementById('pagination-info');
                    if (paginationInfo) {
                        const currentPage = parseInt(paginationInfo.dataset.currentPage);
                        const totalCount = parseInt(paginationInfo.dataset.totalCount);
                        const limit = parseInt(paginationInfo.dataset.limit);
                        const hasMore = paginationInfo.dataset.hasMore === 'true';
                        
                        this.currentPage = currentPage;
                        this.totalCount = totalCount;
                        this.hasMore = hasMore;
                    }
                },
                
                applyFilters() {
                    this.loadProducts(true);
                },
                
                loadMore() {
                    if (this.hasMore && !this.loading) {
                        this.currentPage++;
                        this.loadProducts(false);
                    }
                },
                
                clearFilters() {
                    this.filters = {
                        search: '',
                        category: '',
                        priceRange: ''
                    };
                    this.sortBy = 'newest';
                    this.loadProducts(true);
                },
                
                addToCart(product) {
                    Alpine.store('cart').addItem(product);
                }
            }
        }
    </script>
} 