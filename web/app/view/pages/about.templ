package pages

import (
	"main/web/app/types"
	"main/web/app/view"
	"main/web/app/view/components"
)

templ About(webconfig types.WebConfig) {
    @view.Index(webconfig) {
        @components.Navigation()
        
        <main class="min-h-screen bg-gray-50">
            <!-- Hero Section -->
            @AboutHero(webconfig)
            
            <!-- Company Story -->
            @CompanyStory()
            
            <!-- Mission & Values -->
            @MissionValues()
            
            <!-- Team Section -->
            @TeamSection()
            
            <!-- Stats Section -->
            @StatsSection()
        </main>
        
    }
}

templ AboutHero(webconfig types.WebConfig) {
    <section class="bg-gradient-to-r from-blue-900 via-blue-800 to-blue-900 text-white py-20" style="background: linear-gradient(135deg, #000755 0%, #1e3a8a 50%, #000755 100%);">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-4xl md:text-6xl font-bold mb-6">About {webconfig.General.CompanyName}</h1>
            <p class="text-xl md:text-2xl mb-8 opacity-90">{webconfig.General.AboutUs}</p>
            <div class="w-20 h-1 mx-auto rounded-full" style="background-color: #f4cc1d;"></div>
        </div>
    </section>
}

templ CompanyStory() {
    <section class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
                <div>
                    <h2 class="text-3xl font-bold mb-6" style="color: #000755;">Our Story</h2>
                    <div class="space-y-6 text-gray-600">
                        <p class="text-lg">
                            Founded in 1995, Alfashop established itself as an exclusive automotive parts importer, 
                            building strategic partnerships with world-renowned manufacturers to bring premium quality 
                            components to the local market at competitive prices.
                        </p>
                        <p>
                            Through nearly three decades of operation, we've evolved from a pioneering import operation 
                            to a leading distribution network, serving automotive professionals and enthusiasts nationwide. 
                            Our exclusive brand partnerships allow us direct access to OEM-quality parts and the latest innovations.
                        </p>
                        <p>
                            Today, Alfashop maintains exclusive import agreements with leading international brands, 
                            ensuring our customers receive authentic, premium automotive parts backed by manufacturer warranties. 
                            Our specialized import expertise and industry relationships guarantee exceptional value and availability.
                        </p>
                    </div>
                </div>
                <div class="mt-8 lg:mt-0">
                    <div class="rounded-2xl h-96 flex items-center justify-center shadow-inner">
                        <img src="/assets/images/logo.png" alt="Alfashop Logo" class="w-full h-full object-contain filter drop-shadow-lg" />

                    </div>
                </div>
            </div>
        </div>
    </section>
}

templ MissionValues() {
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold mb-4" style="color: #000755;">Our Mission & Values</h2>
                <p class="text-lg text-gray-600">The principles that drive everything we do</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                @ValueCard(
                    "Exclusive Partnerships",
                    "We maintain strategic import partnerships with world-leading manufacturers, ensuring access to premium OEM-quality parts and competitive pricing.",
                    "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
                )
                @ValueCard(
                    "Import Excellence",
                    "Our specialized import operations and logistics expertise ensure reliable supply chains and exceptional product availability for our customers.",
                    "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
                )
                @ValueCard(
                    "Market Leadership",
                    "We continuously expand our brand portfolio and strengthen international relationships to offer the latest innovations in automotive technology.",
                    "M13 10V3L4 14h7v7l9-11h-7z",
                )
            </div>
        </div>
    </section>
}

templ ValueCard(title, description, iconPath string) {
    <div class="text-center p-6 bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-300">
        <div class="w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-4 shadow-md" style="background: linear-gradient(135deg, #f4cc1d 0%, #e6b800 100%);">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #000755;">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={ iconPath }/>
            </svg>
        </div>
        <h3 class="text-xl font-semibold mb-3" style="color: #000755;">{ title }</h3>
        <p class="text-gray-600">{ description }</p>
    </div>
}

templ TeamSection() {
    <section class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold mb-4" style="color: #000755;">Meet Our Team</h2>
                <p class="text-lg text-gray-600">Import specialists and partnership experts driving Alfashop's success</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                @TeamMember("Alex Rodriguez", "Founder & CEO", "With over 30 years in automotive import business, Alex established Alfashop's exclusive brand partnerships and strategic market positioning.")
                @TeamMember("Sarah Chen", "Chief Import Operations", "Sarah manages our international supplier relationships and import logistics, ensuring seamless delivery of premium automotive parts.")
                @TeamMember("Mike Johnson", "Brand Partnership Director", "Mike develops and maintains exclusive agreements with leading automotive manufacturers, expanding our premium product portfolio.")
            </div>
        </div>
    </section>
}

templ TeamMember(name, position, description string) {
    <div class="text-center">
        <div class="w-32 h-32 mx-auto rounded-full bg-gray-200 mb-4 flex items-center justify-center">
            <svg class="w-16 h-16 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
            </svg>
        </div>
        <h3 class="text-xl font-semibold mb-1" style="color: #000755;">{ name }</h3>
        <p class="font-medium mb-3" style="color: #f4cc1d;">{ position }</p>
        <p class="text-gray-600">{ description }</p>
    </div>
}

templ StatsSection() {
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold mb-4" style="color: #000755;">Alfashop by the Numbers</h2>
                <p class="text-lg text-gray-600">Our commitment to excellence shows in our results</p>
            </div>
            
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                @StatCard("50,000+", "Products Available")
                @StatCard("250,000+", "Happy Customers")
                @StatCard("99.5%", "Customer Satisfaction")
                @StatCard("28 Years", "In Business")
            </div>
        </div>
    </section>
}

templ StatCard(number, label string) {
    <div class="text-center">
        <div class="text-3xl md:text-4xl font-bold mb-2" style="color: #f4cc1d;">{ number }</div>
        <div class="text-gray-600 font-medium">{ label }</div>
    </div>
} 