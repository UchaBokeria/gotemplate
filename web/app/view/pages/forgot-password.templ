package pages

import (
	"main/web/app/types"
)

templ ForgotPassword(webconfig types.WebConfig) {
    <div class="max-w-md w-full space-y-8">
        @ForgotPasswordCard(webconfig)
    </div>
}

templ ForgotPasswordCard(webconfig types.WebConfig) {
    <div class="bg-white rounded-xl shadow-lg p-8" x-data="forgotPassword()">
        <!-- Logo and Header -->
        <div class="text-center mb-8">
            <div class="w-20 h-20 mx-auto rounded-2xl flex items-center justify-center shadow-xl mb-6 overflow-hidden transition-transform duration-200 hover:scale-105" style="background: linear-gradient(135deg, #f4cc1d 0%, #e6b800 100%); border: 3px solid rgba(0, 7, 85, 0.1);">
                <img src="/assets/images/logo.png" alt="Alfashop Logo" class="w-16 h-16 object-contain filter drop-shadow-md" />
            </div>
            <h2 class="text-3xl font-bold tracking-tight" style="color: #000755;">{ webconfig.Translations["forgot_password.reset_password"] }</h2>
            <p class="text-gray-600 mt-2 font-medium">{ webconfig.Translations["forgot_password.enter_email"] }</p>
        </div>

        <!-- Email Sent Success -->
        <div x-show="emailSent" x-transition class="text-center space-y-4">
            <div class="w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-4" style="background-color: #f4cc1d;">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #000755;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
            </div>
            <h3 class="text-xl font-semibold" style="color: #000755;">{ webconfig.Translations["forgot_password.check_email"] }</h3>
            <p class="text-gray-600">
                { webconfig.Translations["forgot_password.sent_instructions"] } <span class="font-medium" x-text="email"></span>
            </p>
            <p class="text-sm text-gray-500">
                { webconfig.Translations["forgot_password.check_spam"] } 
                <button @click="emailSent = false" class="underline hover:no-underline" style="color: #000755;">{ webconfig.Translations["forgot_password.try_again"] }</button>
            </p>
            <div class="mt-6">
                <a href="/login" class="w-full inline-block text-center py-3 px-4 text-blue-900 font-semibold rounded-md shadow-sm hover:shadow-md transition-all duration-200" style="background-color: #f4cc1d; color: #000755;">
                    { webconfig.Translations["forgot_password.back_to_login"] }
                </a>
            </div>
        </div>

        <!-- Reset Form -->
        <div x-show="!emailSent" x-transition>
            <form class="space-y-6" @submit.prevent="submitReset">
                <div>
                    <label for="reset-email" class="block text-sm font-medium text-gray-700 mb-2">{ webconfig.Translations["forgot_password.email_address"] }</label>
                    <input 
                        type="email" 
                        id="reset-email" 
                        x-model="email"
                        required
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm form-input focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent"
                        placeholder={ webconfig.Translations["forgot_password.email_placeholder"] }
                    />
                </div>
                
                <button 
                    type="submit" 
                    :disabled="!email || loading"
                    :class="!email || loading ? 'opacity-50 cursor-not-allowed' : ''"
                    class="w-full py-3 px-4 text-blue-900 font-semibold rounded-md shadow-sm hover:shadow-md transition-all duration-200 hover:scale-105"
                    style="background-color: #f4cc1d; color: #000755;"
                >
                    <span x-show="!loading">{ webconfig.Translations["forgot_password.send_instructions"] }</span>
                    <span x-show="loading" class="flex items-center justify-center">
                        <svg class="w-5 h-5 mr-2 animate-spin" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        { webconfig.Translations["forgot_password.sending"] }
                    </span>
                </button>
            </form>

            <!-- Additional Options -->
            <div class="mt-8 text-center space-y-4">
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-300"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-2 bg-white text-gray-500">{ webconfig.Translations["forgot_password.or"] }</span>
                    </div>
                </div>
                
                <div class="space-y-2">
                    <a href="/login" class="block text-center text-sm hover:underline" style="color: #000755;">
                        { webconfig.Translations["forgot_password.remember_password"] }
                    </a>
                    <a href="/register" class="block text-center text-sm text-gray-500 hover:underline">
                        { webconfig.Translations["forgot_password.no_account"] }
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alpine.js Component -->
    <script>
        function forgotPassword() {
            return {
                email: '',
                loading: false,
                emailSent: false,

                async submitReset() {
                    if (!this.email) return;
                    
                    this.loading = true;
                    
                    // Simulate API call
                    setTimeout(() => {
                        this.loading = false;
                        this.emailSent = true;
                        Alpine.store('auth').resetPassword(this.email);
                    }, 1500);
                }
            }
        }
    </script>
} 