package pages

import (
	"main/web/app/types"
)

templ Profile(webconfig types.WebConfig) {
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col items-center justify-center min-h-[60vh]">
            <h1 class="text-3xl font-bold mb-4" style="color: #000755;">{ webconfig.Translations["profile.title"] }</h1>
            <p class="text-gray-600 text-center">Profile page content will be implemented here</p>
        </div>
    </div>
}
