package pages

import (
	"main/web/app/types"
)

templ Landing(webconfig types.WebConfig) {
    @HeroSection(webconfig)
    
    <!-- Product Catalogs Section -->
    <div class="py-12" x-data="{ categories: [] }" x-init="loadProductCategories()">
        <template x-for="category in categories.slice(0, 4)" :key="category">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
                <div class="text-center mb-8">
                    <h2 class="text-3xl font-bold mb-4" style="color: #000755;" x-text="category.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase())"></h2>
                    <p class="text-lg text-gray-600" x-text="`Premium ${category.replace('-', ' ')} for all vehicle makes`"></p>
                </div>
                
                <!-- Product Carousel Container -->
                <div class="bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-shadow duration-300">
                    <div class="text-center">
                        <a 
                            :href="`/products?category=${category}`" 
                            class="inline-block text-blue-900 px-6 py-3 rounded-lg font-semibold hover:bg-yellow-400 transition-all duration-300 hover:scale-105 shadow-md hover:shadow-lg" 
                            style="background-color: #f4cc1d; color: #000755;"
                            x-text="`View All ${category.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase())}`"
                        >
                        </a>
                    </div>
                </div>
            </div>
        </template>
    </div>
    
    <script>
        function loadProductCategories() {
            fetch('/products/categories')
                .then(response => response.json())
                .then(data => {
                    this.categories = data.categories || [];
                })
                .catch(error => {
                    console.error('Error loading categories:', error);
                    this.categories = [];
                });
        }
    </script>
    
    <!-- Features Section -->
    @FeaturesSection(webconfig)
}

templ HeroSection(webconfig types.WebConfig) {
    <section class="bg-gradient-to-r from-blue-900 via-blue-800 to-blue-900 text-white py-20 relative overflow-hidden" style="background: linear-gradient(135deg, #000755 0%, #1e3a8a 50%, #000755 100%);">
        <!-- Background decoration -->
        <div class="absolute inset-0 bg-black opacity-10"></div>
        <div class="absolute top-0 left-0 w-full h-full">
            <div class="absolute top-10 left-10 w-20 h-20 rounded-full animate-pulse opacity-20" style="background-color: #f4cc1d;"></div>
            <div class="absolute bottom-10 right-10 w-32 h-32 rounded-full animate-pulse delay-1000 opacity-10" style="background-color: #f4cc1d;"></div>
            <div class="absolute top-1/2 left-1/4 w-16 h-16 rounded-full animate-pulse delay-500 opacity-20" style="background-color: #f4cc1d;"></div>
        </div>
        
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center">
                <h1 class="text-4xl md:text-6xl font-bold mb-6 animate-fade-in-up">
                    { webconfig.Translations["landing.hero_title"] }
                </h1>
                <p class="text-xl md:text-2xl mb-8 opacity-90 animate-fade-in-up delay-200">
                    { webconfig.Translations["landing.hero_subtitle"] }
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-up delay-400">
                    <a href="/products" class="inline-block text-blue-900 px-8 py-4 rounded-lg font-semibold text-lg hover:bg-yellow-400 transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl" style="background-color: #f4cc1d; color: #000755;">
                        { webconfig.Translations["landing.browse_auto_parts"] }
                    </a>
                    <a href="/register" class="inline-block bg-transparent border-2 text-white px-8 py-4 rounded-lg font-semibold text-lg hover:text-blue-900 transition-all duration-300 hover:scale-105" style="border-color: #f4cc1d; hover:background-color: #f4cc1d;">
                        { webconfig.Translations["landing.create_account"] }
                    </a>
                </div>
            </div>
        </div>
    </section>
}

templ FeaturesSection(webconfig types.WebConfig) {
    <section class="bg-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold mb-4" style="color: #000755;">{ webconfig.Translations["landing.why_choose_title"] }</h2>
                <p class="text-lg text-gray-600">{ webconfig.Translations["landing.why_choose_subtitle"] }</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                @FeatureCard(
                    webconfig.Translations["landing.feature_1_title"],
                    webconfig.Translations["landing.feature_1_desc"],
                    "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
                )
                @FeatureCard(
                    webconfig.Translations["landing.feature_2_title"],
                    webconfig.Translations["landing.feature_2_desc"],
                    "M13 10V3L4 14h7v7l9-11h-7z",
                )
                @FeatureCard(
                    webconfig.Translations["landing.feature_3_title"],
                    webconfig.Translations["landing.feature_3_desc"],
                    "M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M12 12h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
                )
            </div>
        </div>
    </section>
}

templ FeatureCard(title, description, iconPath string) {
    <div class="text-center p-6 group hover:bg-gray-50 rounded-xl transition-all duration-300 hover:scale-105">
        <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:shadow-lg transition-all duration-300" style="background: linear-gradient(135deg, #f4cc1d 0%, #e6b800 100%);">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #000755;">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={ iconPath }/>
            </svg>
        </div>
        <h3 class="text-xl font-semibold mb-2 group-hover:text-blue-900 transition-colors" style="color: #000755;">{ title }</h3>
        <p class="text-gray-600 group-hover:text-gray-700 transition-colors">{ description }</p>
    </div>
}
