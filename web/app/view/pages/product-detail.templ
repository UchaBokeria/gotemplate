package pages

import (
	"main/web/app/types"
	"main/web/app/view" 
	"main/web/app/view/components"
)

templ ProductDetail(webconfig types.WebConfig) {
    @view.Index(webconfig) {
        @components.Navigation()
        
        <main class="min-h-screen bg-gray-50" x-data="productDetail()">
            <!-- Breadcrumb -->
            <div class="bg-white border-b">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
                    <nav class="flex text-sm">
                        <a href="/" class="text-gray-500 hover:text-blue-900" style="hover:color: #000755;">Home</a>
                        <span class="mx-2 text-gray-400">/</span>
                        <a href="/products" class="text-gray-500 hover:text-blue-900" style="hover:color: #000755;">Auto Parts</a>
                        <span class="mx-2 text-gray-400">/</span>
                        <span style="color: #000755;" x-text="product.name">Product Name</span>
                    </nav>
                </div>
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                <div class="lg:grid lg:grid-cols-2 lg:gap-12">
                    <!-- Product Images -->
                    <div class="mb-8 lg:mb-0">
                        @ProductImages()
                    </div>

                    <!-- Product Information -->
                    <div>
                        @ProductInfo()
                    </div>
                </div>

                <!-- Product Details Tabs -->
                <div class="mt-16">
                    @ProductTabs()
                </div>

                <!-- Related Products -->
                <div class="mt-16">
                    @RelatedProducts()
                </div>
            </div>
        </main>
    }
}

templ ProductImages() {
    <div class="space-y-4">
        <!-- Main Image -->
        <div class="aspect-square bg-white rounded-lg shadow-sm overflow-hidden">
            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200">
                <svg class="w-24 h-24 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 7.172V5L8 4z"/>
                </svg>
            </div>
        </div>

        <!-- Thumbnail Images -->
        <div class="grid grid-cols-4 gap-2">
            <template x-for="i in 4" :key="i">
                <div class="aspect-square bg-white rounded-md shadow-sm overflow-hidden cursor-pointer hover:shadow-md transition-shadow">
                    <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200">
                        <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 7.172V5L8 4z"/>
                        </svg>
                    </div>
                </div>
            </template>
        </div>
    </div>
}

templ ProductInfo() {
    <div class="space-y-6">
        <!-- Product Title & Rating -->
        <div>
            <h1 class="text-3xl font-bold mb-2" style="color: #000755;" x-text="product.name">Premium Engine Air Filter</h1>
            <div class="flex items-center space-x-2 mb-2">
                <div class="flex text-yellow-400">
                    <template x-for="i in 5" :key="i">
                        <svg :class="i <= product.rating ? 'text-yellow-400' : 'text-gray-300'" class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                    </template>
                </div>
                <span class="text-sm text-gray-600" x-text="`(${product.reviews} reviews)`">(127 reviews)</span>
            </div>
            <p class="text-gray-600" x-text="product.shortDescription">High-performance air filter designed for optimal engine protection and performance.</p>
        </div>

        <!-- Price -->
        <div class="border-t border-b py-4">
            <div class="text-3xl font-bold mb-2" style="color: #f4cc1d;" x-text="'$' + product.price">$24.99</div>
            <div class="text-sm text-gray-600">
                <span class="line-through text-gray-400" x-text="product.originalPrice ? '$' + product.originalPrice : ''">$29.99</span>
                <span class="ml-2 text-green-600 font-medium" x-show="product.originalPrice">Save $5.00</span>
            </div>
        </div>

        <!-- Product Options -->
        <div class="space-y-4">
            <!-- Quantity -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Quantity</label>
                <div class="flex items-center space-x-3">
                    <button @click="quantity > 1 ? quantity-- : quantity" class="w-10 h-10 rounded-md border border-gray-300 flex items-center justify-center hover:bg-gray-50 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
                        </svg>
                    </button>
                    <input x-model="quantity" type="number" min="1" class="w-20 px-3 py-2 border border-gray-300 rounded-md text-center form-input focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent" />
                    <button @click="quantity++" class="w-10 h-10 rounded-md border border-gray-300 flex items-center justify-center hover:bg-gray-50 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Vehicle Compatibility -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Vehicle Compatibility</label>
                <select class="w-full px-3 py-2 border border-gray-300 rounded-md form-input focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent">
                    <option>Select your vehicle...</option>
                    <option>2020-2024 Toyota Camry</option>
                    <option>2018-2024 Honda Accord</option>
                    <option>2019-2024 Nissan Altima</option>
                    <option>Universal Fit</option>
                </select>
            </div>
        </div>

        <!-- Add to Cart -->
        <div class="space-y-3">
            <button 
                @click="addToCart()"
                class="w-full py-3 px-6 text-blue-900 font-semibold rounded-md shadow-sm hover:shadow-md transition-all duration-200 hover:scale-105"
                style="background-color: #f4cc1d; color: #000755;"
            >
                Add to Cart
            </button>
            <button class="w-full py-3 px-6 border-2 border-gray-300 text-gray-700 font-semibold rounded-md hover:bg-gray-50 transition-colors">
                Add to Wishlist
            </button>
        </div>

        <!-- Product Features -->
        <div class="border-t pt-6">
            <h3 class="font-semibold mb-3" style="color: #000755;">Key Features</h3>
            <ul class="space-y-2 text-sm text-gray-600">
                <li class="flex items-center">
                    <svg class="w-4 h-4 mr-2" style="color: #f4cc1d;" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    OEM Quality Construction
                </li>
                <li class="flex items-center">
                    <svg class="w-4 h-4 mr-2" style="color: #f4cc1d;" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    99.9% Filtration Efficiency
                </li>
                <li class="flex items-center">
                    <svg class="w-4 h-4 mr-2" style="color: #f4cc1d;" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    Easy Installation
                </li>
                <li class="flex items-center">
                    <svg class="w-4 h-4 mr-2" style="color: #f4cc1d;" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    12-Month Warranty
                </li>
            </ul>
        </div>
    </div>
}

templ ProductTabs() {
    <div x-data="{ activeTab: 'description' }">
        <!-- Tab Navigation -->
        <div class="border-b border-gray-200">
            <nav class="flex space-x-8">
                <button 
                    @click="activeTab = 'description'"
                    :class="activeTab === 'description' ? 'border-yellow-500 text-blue-900' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'"
                    class="py-4 px-1 border-b-2 font-medium text-sm transition-colors"
                    :style="activeTab === 'description' ? 'border-color: #f4cc1d; color: #000755;' : ''"
                >
                    Description
                </button>
                <button 
                    @click="activeTab = 'specifications'"
                    :class="activeTab === 'specifications' ? 'border-yellow-500 text-blue-900' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'"
                    class="py-4 px-1 border-b-2 font-medium text-sm transition-colors"
                    :style="activeTab === 'specifications' ? 'border-color: #f4cc1d; color: #000755;' : ''"
                >
                    Specifications
                </button>
                <button 
                    @click="activeTab = 'compatibility'"
                    :class="activeTab === 'compatibility' ? 'border-yellow-500 text-blue-900' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'"
                    class="py-4 px-1 border-b-2 font-medium text-sm transition-colors"
                    :style="activeTab === 'compatibility' ? 'border-color: #f4cc1d; color: #000755;' : ''"
                >
                    Compatibility
                </button>
                <button 
                    @click="activeTab = 'reviews'"
                    :class="activeTab === 'reviews' ? 'border-yellow-500 text-blue-900' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'"
                    class="py-4 px-1 border-b-2 font-medium text-sm transition-colors"
                    :style="activeTab === 'reviews' ? 'border-color: #f4cc1d; color: #000755;' : ''"
                >
                    Reviews (127)
                </button>
            </nav>
        </div>

        <!-- Tab Content -->
        <div class="py-8">
            <!-- Description Tab -->
            <div x-show="activeTab === 'description'" x-transition>
                <div class="prose max-w-none">
                    <h3 style="color: #000755;">Product Description</h3>
                    <p class="text-gray-600">
                        This premium engine air filter is designed to provide superior protection for your vehicle's engine while maintaining optimal airflow. 
                        Constructed with high-quality materials and advanced filtration technology, it effectively removes dust, debris, and contaminants 
                        from the air entering your engine.
                    </p>
                    <p class="text-gray-600">
                        The multi-layer filtration system ensures maximum efficiency while maintaining proper airflow to your engine. 
                        This results in improved engine performance, better fuel economy, and extended engine life.
                    </p>
                    <h4 style="color: #000755;">Benefits:</h4>
                    <ul class="text-gray-600">
                        <li>Improved engine performance and efficiency</li>
                        <li>Better fuel economy</li>
                        <li>Extended engine life</li>
                        <li>Easy installation with no tools required</li>
                        <li>Environmentally friendly and recyclable</li>
                    </ul>
                </div>
            </div>

            <!-- Specifications Tab -->
            <div x-show="activeTab === 'specifications'" x-transition>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <h3 class="font-semibold mb-4" style="color: #000755;">Technical Specifications</h3>
                        <dl class="space-y-2">
                            <div class="flex justify-between">
                                <dt class="text-gray-600">Part Number:</dt>
                                <dd class="font-medium">AF-2024-001</dd>
                            </div>
                            <div class="flex justify-between">
                                <dt class="text-gray-600">Filter Type:</dt>
                                <dd class="font-medium">Dry Element</dd>
                            </div>
                            <div class="flex justify-between">
                                <dt class="text-gray-600">Material:</dt>
                                <dd class="font-medium">Synthetic Blend</dd>
                            </div>
                            <div class="flex justify-between">
                                <dt class="text-gray-600">Filtration Efficiency:</dt>
                                <dd class="font-medium">99.9%</dd>
                            </div>
                            <div class="flex justify-between">
                                <dt class="text-gray-600">Service Life:</dt>
                                <dd class="font-medium">12,000 miles</dd>
                            </div>
                        </dl>
                    </div>
                    <div>
                        <h3 class="font-semibold mb-4" style="color: #000755;">Dimensions</h3>
                        <dl class="space-y-2">
                            <div class="flex justify-between">
                                <dt class="text-gray-600">Length:</dt>
                                <dd class="font-medium">10.5 inches</dd>
                            </div>
                            <div class="flex justify-between">
                                <dt class="text-gray-600">Width:</dt>
                                <dd class="font-medium">8.25 inches</dd>
                            </div>
                            <div class="flex justify-between">
                                <dt class="text-gray-600">Height:</dt>
                                <dd class="font-medium">1.5 inches</dd>
                            </div>
                            <div class="flex justify-between">
                                <dt class="text-gray-600">Weight:</dt>
                                <dd class="font-medium">0.8 lbs</dd>
                            </div>
                        </dl>
                    </div>
                </div>
            </div>

            <!-- Compatibility Tab -->
            <div x-show="activeTab === 'compatibility'" x-transition>
                <h3 class="font-semibold mb-4" style="color: #000755;">Vehicle Compatibility</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <div class="border rounded-lg p-4">
                        <h4 class="font-medium mb-2">Toyota</h4>
                        <ul class="text-sm text-gray-600 space-y-1">
                            <li>Camry (2020-2024)</li>
                            <li>Corolla (2020-2024)</li>
                            <li>RAV4 (2019-2024)</li>
                        </ul>
                    </div>
                    <div class="border rounded-lg p-4">
                        <h4 class="font-medium mb-2">Honda</h4>
                        <ul class="text-sm text-gray-600 space-y-1">
                            <li>Accord (2018-2024)</li>
                            <li>Civic (2019-2024)</li>
                            <li>CR-V (2017-2024)</li>
                        </ul>
                    </div>
                    <div class="border rounded-lg p-4">
                        <h4 class="font-medium mb-2">Nissan</h4>
                        <ul class="text-sm text-gray-600 space-y-1">
                            <li>Altima (2019-2024)</li>
                            <li>Sentra (2020-2024)</li>
                            <li>Rogue (2021-2024)</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Reviews Tab -->
            <div x-show="activeTab === 'reviews'" x-transition>
                <div class="space-y-6">
                    <div class="flex items-center justify-between">
                        <h3 class="font-semibold" style="color: #000755;">Customer Reviews</h3>
                        <button class="px-4 py-2 text-blue-900 font-semibold rounded-md border-2 border-yellow-500 hover:bg-yellow-50 transition-colors" style="border-color: #f4cc1d; color: #000755;">
                            Write a Review
                        </button>
                    </div>
                    
                    <div class="space-y-4">
                        <template x-for="i in 3" :key="i">
                            <div class="border-b pb-4">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center space-x-2">
                                        <div class="flex text-yellow-400">
                                            <template x-for="j in 5" :key="j">
                                                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                                </svg>
                                            </template>
                                        </div>
                                        <span class="font-medium">John D.</span>
                                    </div>
                                    <span class="text-sm text-gray-500">2 weeks ago</span>
                                </div>
                                <p class="text-gray-600">"Excellent quality filter! Easy to install and my engine runs much smoother now. Definitely worth the investment."</p>
                            </div>
                        </template>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

templ RelatedProducts() {
    <div>
        <h2 class="text-2xl font-bold mb-6" style="color: #000755;">Related Products</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            <template x-for="i in 4" :key="i">
                <div class="bg-white rounded-lg shadow-sm hover:shadow-lg transition-all duration-300 cursor-pointer">
                    <div class="aspect-square bg-gray-100 rounded-t-lg overflow-hidden">
                        <div class="w-full h-full flex items-center justify-center">
                            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 7.172V5L8 4z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="p-4">
                        <h3 class="font-semibold text-sm mb-1" style="color: #000755;">Related Filter</h3>
                        <p class="text-sm text-gray-600 mb-2">High quality automotive part</p>
                        <div class="flex items-center justify-between">
                            <span class="font-bold" style="color: #f4cc1d;">$19.99</span>
                            <button class="text-xs px-3 py-1 rounded-md text-blue-900 font-semibold transition-colors hover:opacity-80" style="background-color: #f4cc1d; color: #000755;">
                                Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            </template>
        </div>
    </div>

    <!-- Product Detail Data Container -->
    <div 
        id="product-detail-container"
        x-init="
            const productId = window.location.pathname.split('/').pop();
            htmx.ajax('GET', `/products/${productId}`, {
                target: '#product-detail-container',
                swap: 'innerHTML'
            });
        "
    >
        <!-- Loading State -->
        <div class="flex justify-center py-12">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500"></div>
        </div>
    </div>

    <!-- Alpine.js Component -->
    <script>
        function productDetail() {
            return {
                quantity: 1,
                product: {
                    id: null,
                    name: '',
                    price: 0,
                    originalPrice: null,
                    rating: 5,
                    reviews: 0,
                    shortDescription: '',
                    category: '',
                    brand: '',
                    inStock: true
                },

                init() {
                    // Listen for product data loaded from HTMX
                    document.addEventListener('product-loaded', (event) => {
                        this.product = { ...this.product, ...event.detail };
                    });
                },

                addToCart() {
                    if (!this.product.id) return;
                    
                    const cartProduct = {
                        ...this.product,
                        quantity: this.quantity
                    };
                    
                    for (let i = 0; i < this.quantity; i++) {
                        Alpine.store('cart').addItem(this.product);
                    }
                }
            }
        }
    </script>
} 