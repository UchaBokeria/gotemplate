package components

import (
	"main/web/app/types"
	"strings"
	"time"
)

templ Footer(webconfig types.WebConfig) {
    <footer class="bg-white border-t border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <!-- Company Info -->
                <div class="col-span-1 md:col-span-2">
                    <div class="flex items-center mb-6">
                        <img src="/assets/images/logo.png" alt="Alfashop Logo" class="w-16 h-16 object-contain" />
                    </div>
                    <p class="text-gray-600 mb-6 max-w-md">{webconfig.General.AboutUs}</p>
                    <div class="space-y-2 text-sm text-gray-600">
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-3" style="color: #f4cc1d;" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                            </svg>
                            <span>{webconfig.General.Address}</span>
                        </div>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-3" style="color: #f4cc1d;" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
                            </svg>
                            <span>{webconfig.General.Phone}</span>
                        </div>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-3" style="color: #f4cc1d;" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
                            </svg>
                            <span>{webconfig.General.Email}</span>
                        </div>
                    </div>
                </div>

                <!-- Quick Links -->
                <div>
                    <h3 class="text-sm font-semibold uppercase tracking-wider mb-4" style="color: #000755;">Quick Links</h3>
                    <ul class="space-y-3">
                        <li><a href="/" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Home</a></li>
                        <li><a href="/products" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Auto Parts</a></li>
                        <li><a href="/about" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">About Us</a></li>
                        <li><a href="#" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Contact</a></li>
                    </ul>
                </div>

                <!-- Product Categories -->
                <div>
                    <h3 class="text-sm font-semibold uppercase tracking-wider mb-4" style="color: #000755;">Product Categories</h3>
                    <ul class="space-y-3">
                        for _, category := range webconfig.Categories[:5] {
                            <li>
                                <a 
                                    href={"/products?category=" + category} 
                                    class="text-gray-600 hover:text-blue-900 transition-colors capitalize" 
                                    style="hover:color: #000755;">
                                    { strings.ReplaceAll(category, "-", " ") }
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <!-- Newsletter & Social -->
            <div class="mt-12 pt-8 border-t border-gray-200">
                <div class="md:flex md:items-center md:justify-between">
                    <div class="mb-6 md:mb-0">
                        <h3 class="text-lg font-semibold mb-2" style="color: #000755;">Stay Updated</h3>
                        <p class="text-gray-600 mb-4">Get the latest news on auto parts and special offers</p>
                        <div class="flex max-w-md" x-data="{ email: '' }">
                            <input 
                                type="email" 
                                x-model="email"
                                placeholder="Enter your email"
                                class="flex-1 px-3 py-2 border border-gray-300 rounded-l-md form-input focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent"
                            />
                            <button 
                                @click="subscribeNewsletter(email)"
                                class="px-4 py-2 text-blue-900 font-semibold rounded-r-md shadow-sm hover:shadow-md transition-all duration-200"
                                style="background-color: #f4cc1d; color: #000755;"
                            >
                                Subscribe
                            </button>
                        </div>
                    </div>

                    <!-- Social Links -->
                    <div class="flex space-x-4">
                        <!-- Facebook -->
                        <a href={webconfig.General.Facebook} target="_blank" rel="noopener noreferrer" class="text-gray-600 p-2" title="Follow us on Facebook">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                            </svg>
                        </a>
                        
                        <!-- Instagram -->
                        <a href={webconfig.General.Instagram} target="_blank" rel="noopener noreferrer" class="text-gray-600 p-2" title="Follow us on Instagram">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                            </svg>
                        </a>
                        
                        <!-- TikTok -->
                        <a href={webconfig.General.TikTok} target="_blank" rel="noopener noreferrer" class="text-gray-600 p-2" title="Follow us on TikTok">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Bottom Section -->
            <div class="mt-8 pt-8 border-t border-gray-200 md:flex md:items-center md:justify-between">
                <div class="flex flex-col md:flex-row md:items-center space-y-2 md:space-y-0 md:space-x-8">
                    <p class="text-sm text-gray-600">
                        © {time.Now().Format("2006")} <span>{webconfig.General.CompanyName}</span>. All rights reserved.
                    </p>
                    <div class="flex space-x-6 text-sm">
                        <a href="#" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Privacy Policy</a>
                        <a href="#" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Terms of Service</a>
                        <a href="#" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Return Policy</a>
                    </div>
                </div>
                <div class="mt-4 md:mt-0">
                    <p class="text-sm text-gray-600">
                        Exclusive partnerships • Premium brands • 250,000+ satisfied customers
                    </p>
                </div>
            </div>
        </div>

        <!-- Alpine.js Functions -->
        <script>
            function subscribeNewsletter(email) {
                if (!email) {
                    alert('Please enter your email address');
                    return;
                }
                console.log('Subscribing email:', email);
                alert('Thank you for subscribing to our newsletter!');
                // Reset email field
                this.email = '';
            }
        </script>
    </footer>
} 