package components

templ Footer() {
    <footer class="bg-white border-t border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <!-- Company Info -->
                <div class="col-span-1 md:col-span-2">
                    <div class="flex items-center space-x-2 mb-4">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center shadow-md" style="background: linear-gradient(135deg, #f4cc1d 0%, #e6b800 100%);">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" style="color: #000755;">
                                <path d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.82,11.69,4.82,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                            </svg>
                        </div>
                        <div>
                            <span class="text-2xl font-bold" style="color: #000755;">Alfashop</span>
                            <div class="text-sm text-gray-600">Auto Parts & Filters</div>
                        </div>
                    </div>
                    <p class="text-gray-600 mb-6 max-w-md">
                        Your trusted partner for quality auto parts since 1995. We provide premium air filters, 
                        oil filters, and automotive parts for all makes and models.
                    </p>
                    <div class="space-y-2 text-sm text-gray-600">
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-3" style="color: #f4cc1d;" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                            </svg>
                            1234 Auto Parts Blvd, Automotive District, AD 12345
                        </div>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-3" style="color: #f4cc1d;" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
                            </svg>
                            (555) 123-AUTO (2886)
                        </div>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-3" style="color: #f4cc1d;" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
                            </svg>
                            support@alfashop.com
                        </div>
                    </div>
                </div>

                <!-- Quick Links -->
                <div>
                    <h3 class="text-sm font-semibold uppercase tracking-wider mb-4" style="color: #000755;">Quick Links</h3>
                    <ul class="space-y-3">
                        <li><a href="/" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Home</a></li>
                        <li><a href="/products" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Auto Parts</a></li>
                        <li><a href="/about" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">About Us</a></li>
                        <li><a href="#" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Contact</a></li>
                    </ul>
                </div>

                <!-- Product Categories -->
                <div>
                    <h3 class="text-sm font-semibold uppercase tracking-wider mb-4" style="color: #000755;">Product Categories</h3>
                    <ul class="space-y-3">
                        <li><a href="/products?category=air-filters" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Air Filters</a></li>
                        <li><a href="/products?category=oil-filters" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Oil Filters</a></li>
                        <li><a href="/products?category=fuel-filters" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Fuel Filters</a></li>
                        <li><a href="/products?category=brake-parts" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Brake Parts</a></li>
                        <li><a href="/products?category=engine-parts" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Engine Parts</a></li>
                    </ul>
                </div>
            </div>

            <!-- Newsletter & Social -->
            <div class="mt-12 pt-8 border-t border-gray-200">
                <div class="md:flex md:items-center md:justify-between">
                    <div class="mb-6 md:mb-0">
                        <h3 class="text-lg font-semibold mb-2" style="color: #000755;">Stay Updated</h3>
                        <p class="text-gray-600 mb-4">Get the latest news on auto parts and special offers</p>
                        <div class="flex max-w-md" x-data="{ email: '' }">
                            <input 
                                type="email" 
                                x-model="email"
                                placeholder="Enter your email"
                                class="flex-1 px-3 py-2 border border-gray-300 rounded-l-md form-input focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent"
                            />
                            <button 
                                @click="subscribeNewsletter(email)"
                                class="px-4 py-2 text-blue-900 font-semibold rounded-r-md shadow-sm hover:shadow-md transition-all duration-200"
                                style="background-color: #f4cc1d; color: #000755;"
                            >
                                Subscribe
                            </button>
                        </div>
                    </div>

                    <!-- Social Links -->
                    <div class="flex space-x-4">
                        <a href="#" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                            </svg>
                        </a>
                        <a href="#" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/>
                            </svg>
                        </a>
                        <a href="#" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.346-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.357-.629-2.746-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24.009 12.017 24.009c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001.012.001z.017-.001z"/>
                            </svg>
                        </a>
                        <a href="#" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Bottom Section -->
            <div class="mt-8 pt-8 border-t border-gray-200 md:flex md:items-center md:justify-between">
                <div class="flex flex-col md:flex-row md:items-center space-y-2 md:space-y-0 md:space-x-8">
                    <p class="text-sm text-gray-600">
                        © 2024 Alfashop. All rights reserved.
                    </p>
                    <div class="flex space-x-6 text-sm">
                        <a href="#" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Privacy Policy</a>
                        <a href="#" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Terms of Service</a>
                        <a href="#" class="text-gray-600 hover:text-blue-900 transition-colors" style="hover:color: #000755;">Return Policy</a>
                    </div>
                </div>
                <div class="mt-4 md:mt-0">
                    <p class="text-sm text-gray-600">
                        Trusted by 250,000+ customers worldwide
                    </p>
                </div>
            </div>
        </div>

        <!-- Alpine.js Functions -->
        <script>
            function subscribeNewsletter(email) {
                if (!email) {
                    alert('Please enter your email address');
                    return;
                }
                console.log('Subscribing email:', email);
                alert('Thank you for subscribing to our newsletter!');
                // Reset email field
                this.email = '';
            }
        </script>
    </footer>
} 