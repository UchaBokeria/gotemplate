package components

templ Navigation() {
    <nav class="bg-white shadow-lg sticky top-0 z-50" x-data="{ mobileMenuOpen: false, languageOpen: false, currentLang: 'EN' }">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <div class="flex-shrink-0">
                    <a href="/" class="flex items-center space-x-2">
                        <div class="w-10 h-10 bg-gradient-to-br from-yellow-400 to-yellow-500 rounded-lg flex items-center justify-center shadow-md" style="background: linear-gradient(135deg, #f4cc1d 0%, #e6b800 100%);">
                            <svg class="w-6 h-6 text-blue-900" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.82,11.69,4.82,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                            </svg>
                        </div>
                        <div>
                            <span class="text-2xl font-bold text-blue-900" style="color: #000755;">Alfashop</span>
                            <div class="text-xs text-gray-600">Auto Parts & Filters</div>
                        </div>
                    </a>
                </div>

                <!-- Desktop Navigation -->
                <div class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-8">
                        <a href="/" class="text-blue-900 hover:text-yellow-500 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200" style="color: #000755;">
                            Home
                        </a>
                        <a href="/products" class="text-blue-900 hover:text-yellow-500 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200" style="color: #000755;">
                            Auto Parts
                        </a>
                        <a href="/about" class="text-blue-900 hover:text-yellow-500 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200" style="color: #000755;">
                            About Us
                        </a>
                    </div>
                </div>

                <!-- Desktop Right Side -->
                <div class="hidden md:flex items-center space-x-4">
                    <!-- Language Switcher -->
                    <div class="relative" x-data="{ open: false }">
                        <button @click="open = !open" class="text-blue-900 hover:text-yellow-500 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200 flex items-center" style="color: #000755;">
                            <span x-text="currentLang"></span>
                            <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        <div x-show="open" @click.away="open = false" x-transition class="absolute right-0 mt-2 w-24 bg-white rounded-md shadow-lg py-1 ring-1 ring-black ring-opacity-5">
                            <a @click="currentLang = 'EN'; open = false" href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">EN</a>
                            <a @click="currentLang = 'RU'; open = false" href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">RU</a>
                            <a @click="currentLang = 'GE'; open = false" href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">GE</a>
                        </div>
                    </div>

                    <!-- Auth Buttons -->
                    <a href="/login" class="text-blue-900 hover:text-yellow-500 px-4 py-2 rounded-md text-sm font-medium transition-colors duration-200" style="color: #000755;">
                        Login
                    </a>
                    <a href="/register" class="bg-yellow-500 hover:bg-yellow-600 text-blue-900 px-4 py-2 rounded-md text-sm font-medium transition-colors duration-200 shadow-md hover:shadow-lg" style="background-color: #f4cc1d; color: #000755;">
                        Register
                    </a>
                </div>

                <!-- Mobile menu button -->
                <div class="md:hidden">
                    <button @click="mobileMenuOpen = !mobileMenuOpen" class="text-blue-900 hover:text-yellow-500 p-2" style="color: #000755;">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path x-show="!mobileMenuOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                            <path x-show="mobileMenuOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation -->
        <div x-show="mobileMenuOpen" x-transition class="md:hidden">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 bg-white border-t">
                <a href="/" class="text-blue-900 hover:text-yellow-500 block px-3 py-2 rounded-md text-base font-medium" style="color: #000755;">Home</a>
                <a href="/products" class="text-blue-900 hover:text-yellow-500 block px-3 py-2 rounded-md text-base font-medium" style="color: #000755;">Auto Parts</a>
                <a href="/about" class="text-blue-900 hover:text-yellow-500 block px-3 py-2 rounded-md text-base font-medium" style="color: #000755;">About Us</a>
                
                <div class="border-t pt-3 mt-3">
                    <div class="flex items-center space-x-2 px-3 py-2">
                        <span class="text-sm text-gray-600">Language:</span>
                        <select x-model="currentLang" class="text-sm border rounded px-2 py-1">
                            <option value="EN">EN</option>
                            <option value="RU">RU</option>
                            <option value="GE">GE</option>
                        </select>
                    </div>
                    <a href="/login" class="text-blue-900 hover:text-yellow-500 block px-3 py-2 rounded-md text-base font-medium" style="color: #000755;">Login</a>
                    <a href="/register" class="bg-yellow-500 hover:bg-yellow-600 text-blue-900 block px-3 py-2 rounded-md text-base font-medium mx-3 mt-2 text-center" style="background-color: #f4cc1d; color: #000755;">Register</a>
                </div>
            </div>
        </div>
    </nav>
} 