package components

import (
	"main/web/app/types"
)

templ Navigation(webconfig types.WebConfig) {
    <nav class="bg-white shadow-lg sticky top-0 z-50" x-data="navigationData()" x-init="loadLanguages(); loadTranslations(currentLang)">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <div class="flex-shrink-0">
                    <a href="/" class="flex items-center">
                        <img src="/assets/images/logo.png" alt={ webconfig.Translations["nav.logo_alt"] } class="w-16 h-16 object-contain" />
                    </a>
                </div>

                <!-- Desktop Navigation -->
                <div class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-8">
                        <a href="/" class="text-blue-900 hover:text-yellow-500 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200" style="color: #000755;">
                            { webconfig.Translations["nav.home"] }
                        </a>
                        <a href="/products" class="text-blue-900 hover:text-yellow-500 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200" style="color: #000755;">
                            { webconfig.Translations["nav.products"] }
                        </a>
                        <a href="/about" class="text-blue-900 hover:text-yellow-500 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200" style="color: #000755;">
                            { webconfig.Translations["nav.about"] }
                        </a>
                    </div>
                </div>

                <!-- Desktop Right Side -->
                <div class="hidden md:flex items-center space-x-4">

                    <!-- Language Switcher -->
                    <div class="relative" x-data="{ open: false }">
                        <button @click="open = !open" class="text-blue-900 hover:text-yellow-500 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200 flex items-center" style="color: #000755;">
                            <span x-text="currentLang.toUpperCase()"></span>
                            <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        <div x-show="open" @click.away="open = false" x-transition class="absolute right-0 mt-2 w-24 bg-white rounded-md shadow-lg py-1 ring-1 ring-black ring-opacity-5">
                            <template x-for="language in availableLanguages" :key="language">
                                <a 
                                    @click="changeLanguage(language); open = false" 
                                    href="#" 
                                    :class="language === currentLang ? 'bg-gray-100 font-medium' : ''"
                                    class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 uppercase"
                                    x-text="language"
                                ></a>
                            </template>
                        </div>
                    </div>

                    <!-- Auth Buttons -->
                    <a href="/login" class="text-blue-900 hover:text-yellow-500 px-4 py-2 rounded-md text-sm font-medium transition-colors duration-200" style="color: #000755;">
                        { webconfig.Translations["nav.login"] }
                    </a>
                    <a href="/register" class="bg-yellow-500 hover:bg-yellow-600 text-blue-900 px-4 py-2 rounded-md text-sm font-medium transition-colors duration-200 shadow-md hover:shadow-lg" style="background-color: #f4cc1d; color: #000755;">
                        { webconfig.Translations["nav.register"] }
                    </a>
                </div>

                <!-- Mobile menu button -->
                <div class="md:hidden flex items-center">
                    <button @click="mobileMenuOpen = !mobileMenuOpen" class="text-blue-900 hover:text-yellow-500 p-2" style="color: #000755;">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path :class="{'hidden': mobileMenuOpen, 'inline-flex': !mobileMenuOpen }" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                            <path :class="{'hidden': !mobileMenuOpen, 'inline-flex': mobileMenuOpen }" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile menu -->
        <div x-show="mobileMenuOpen" x-transition class="md:hidden">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 bg-white border-t">
                <a href="/" class="text-blue-900 hover:text-yellow-500 block px-3 py-2 rounded-md text-base font-medium" style="color: #000755;">
                    { webconfig.Translations["nav.home"] }
                </a>
                <a href="/products" class="text-blue-900 hover:text-yellow-500 block px-3 py-2 rounded-md text-base font-medium" style="color: #000755;">
                    { webconfig.Translations["nav.products"] }
                </a>
                <a href="/about" class="text-blue-900 hover:text-yellow-500 block px-3 py-2 rounded-md text-base font-medium" style="color: #000755;">
                    { webconfig.Translations["nav.about"] }
                </a>
                
                <div class="border-t pt-3 mt-3">
                    <div class="flex items-center space-x-2 px-3 py-2">
                        <span class="text-sm text-gray-600">{ webconfig.Translations["nav.language"] }:</span>
                        <select x-model="currentLang" @change="changeLanguage(currentLang)" class="text-sm border rounded px-2 py-1">
                            <template x-for="language in availableLanguages" :key="language">
                                <option :value="language" x-text="language.toUpperCase()"></option>
                            </template>
                        </select>
                    </div>
                    <a href="/login" class="text-blue-900 hover:text-yellow-500 block px-3 py-2 rounded-md text-base font-medium" style="color: #000755;">
                        { webconfig.Translations["nav.login"] }
                    </a>
                    <a href="/register" class="bg-yellow-500 hover:bg-yellow-600 text-blue-900 block px-3 py-2 rounded-md text-base font-medium mx-3 mt-2 text-center" style="background-color: #f4cc1d; color: #000755;">
                        { webconfig.Translations["nav.register"] }
                    </a>
                </div>
            </div>
        </div>

        <script>
            function navigationData() {
                return {
                    mobileMenuOpen: false,
                    languageOpen: false,
                    currentLang: localStorage.getItem('alfashop_language') || 'en',
                    availableLanguages: ['en', 'ru', 'ge'],
                    translations: {},

                    init() {
                        // Set Accept-Language header on initialization
                        this.setLanguageHeader(this.currentLang);
                    },

                    setLanguageHeader(language) {
            
                    },

                    async loadLanguages() {
                        // Languages are now handled by middleware
                        this.availableLanguages = ['en', 'ru', 'ge'];
                    },

                    async loadTranslations(language) {
                        // Translations are now handled by middleware
                        // The middleware will provide translations in the context
                        this.translations = {};
                    },

                    async changeLanguage(language) {
                        this.currentLang = language;
                        localStorage.setItem('alfashop_language', language);
                        
                        // Set Accept-Language header for all future requests
                        this.setLanguageHeader(language);
                        
                        await this.loadTranslations(language);
                        
                        // Dispatch custom event for other components to react
                        document.dispatchEvent(new CustomEvent('language-changed', {
                            detail: { language, translations: this.translations }
                        }));
                        
                        // Redirect to update language server-side
                        const currentPath = window.location.pathname + window.location.search;
                        window.location.href = `/translate/${language}?redirect=${encodeURIComponent(currentPath)}`;
                    },

                    getTranslation(key, fallback) {
                        return this.translations[key] || fallback;
                    }
                }
            }
        </script>
    </nav>
} 