package components

import (
	"main/internal/models"
	"main/web/app/types"
	"fmt"
	"strconv"
)

templ ProductsGridData(products []models.Product, page int, limit int, totalCount int, webconfig types.WebConfig) {
	<div class="products-container">
		if len(products) == 0 {
			<div class="col-span-full text-center py-12">
				<svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 7.172V5L8 4z"/>
				</svg>
				<p class="text-lg font-medium text-gray-900 mb-2">{ webconfig.Translations["product.no_products_found"] }</p>
				<p class="text-gray-500">{ webconfig.Translations["product.adjust_filters"] }</p>
			</div>
		} else {
			for _, product := range products {
				@ProductCard(product, webconfig)
			}
		}
		
		<!-- Pagination info for infinite scroll -->
		<div 
			id="pagination-info" 
			data-current-page={ strconv.Itoa(page) }
			data-total-count={ strconv.Itoa(totalCount) }
			data-limit={ strconv.Itoa(limit) }
			data-has-more={ strconv.FormatBool((page * limit) < totalCount) }
			class="hidden"
		></div>
	</div>
}

templ ProductCard(product models.Product, webconfig types.WebConfig) {
	<div class="product-card bg-white rounded-lg shadow-sm hover:shadow-lg transition-all duration-300">
		<!-- Grid View -->
		<div x-show="viewMode === 'grid'" class="p-6">
			<a href={ templ.URL(fmt.Sprintf("/products/%d", product.ID)) } class="block">
				<div class="aspect-square bg-gray-100 rounded-lg mb-4 overflow-hidden">
					<div class="w-full h-full flex items-center justify-center">
						<svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 7.172V5L8 4z"/>
						</svg>
					</div>
				</div>
				<h3 class="font-semibold text-gray-900 mb-2" style="color: #000755;">{ product.Name }</h3>
				<p class="text-sm text-gray-600 mb-2">{ product.Description }</p>
				<div class="flex items-center mb-2">
					<div class="flex text-yellow-400">
						for i := 1; i <= 5; i++ {
							<svg class="w-4 h-4 fill-current text-yellow-400" viewBox="0 0 20 20">
								<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
							</svg>
						}
					</div>
					<span class="ml-2 text-sm text-gray-600">{ webconfig.Translations["product.rating"] }</span>
				</div>
			</a>
			<div class="flex items-center justify-between">
				<span class="text-xl font-bold" style="color: #f4cc1d;">${ fmt.Sprintf("%.2f", product.Price) }</span>
				<button 
					@click.stop={ fmt.Sprintf("addToCart({id: %d, name: '%s', price: %.2f})", product.ID, product.Name, product.Price) }
					class="px-4 py-2 text-blue-900 font-semibold rounded-md shadow-sm hover:shadow-md transition-all duration-200 hover:scale-105"
					style="background-color: #f4cc1d; color: #000755;"
				>
					{ webconfig.Translations["product.add_to_cart"] }
				</button>
			</div>
		</div>
		
		<!-- List View -->
		<div x-show="viewMode === 'list'" class="flex p-6">
			<div class="w-24 h-24 bg-gray-100 rounded-lg mr-4 flex-shrink-0">
				<div class="w-full h-full flex items-center justify-center">
					<svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 7.172V5L8 4z"/>
					</svg>
				</div>
			</div>
			<div class="flex-1">
				<h3 class="font-semibold text-lg mb-1" style="color: #000755;">{ product.Name }</h3>
				<p class="text-gray-600 mb-2">{ product.Description }</p>
				<div class="flex items-center mb-2">
					<div class="flex text-yellow-400 mr-2">
						for i := 1; i <= 5; i++ {
							<svg class="w-4 h-4 fill-current text-yellow-400" viewBox="0 0 20 20">
								<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
							</svg>
						}
					</div>
					<span class="text-sm text-gray-600">{ webconfig.Translations["product.rating_reviews"] }</span>
				</div>
				<div class="flex items-center justify-between">
					<span class="text-2xl font-bold" style="color: #f4cc1d;">${ fmt.Sprintf("%.2f", product.Price) }</span>
					<button 
						@click={ fmt.Sprintf("addToCart({id: %d, name: '%s', price: %.2f})", product.ID, product.Name, product.Price) }
						class="px-6 py-2 text-blue-900 font-semibold rounded-md shadow-sm hover:shadow-md transition-all duration-200 hover:scale-105"
						style="background-color: #f4cc1d; color: #000755;"
					>
						{ webconfig.Translations["product.add_to_cart"] }
					</button>
				</div>
			</div>
		</div>
	</div>
}

templ ProductDetailData(product models.Product, relatedProducts []models.Product, webconfig types.WebConfig) {
	<div class="product-detail-data">
		<script>
			document.dispatchEvent(new CustomEvent('product-loaded', {
				detail: {
					id: { strconv.Itoa(product.ID) },
					name: { fmt.Sprintf("'%s'", product.Name) },
					price: { fmt.Sprintf("%.2f", product.Price) },
					description: { fmt.Sprintf("'%s'", product.Description) },
					category: { fmt.Sprintf("'%s'", product.Category) },
					stock: { strconv.Itoa(product.Stock) },
					status: { fmt.Sprintf("'%s'", product.Status) }
				}
			}));
		</script>
		
		<div class="related-products-data hidden" data-products={ fmt.Sprintf("%v", relatedProducts) }></div>
	</div>
}

templ ProductNotFound(webconfig types.WebConfig) {
	<div class="text-center py-16">
		<svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.447.935-6 2.45"/>
		</svg>
		<h3 class="text-lg font-medium text-gray-900 mb-2">{ webconfig.Translations["product.not_found"] }</h3>
		<p class="text-gray-500 mb-4">{ webconfig.Translations["product.not_found_description"] }</p>
		<a href="/products" class="inline-block px-4 py-2 rounded-md font-medium text-white" style="background-color: #f4cc1d; color: #000755;">
			{ webconfig.Translations["product.browse_all"] }
		</a>
	</div>
}

templ CategoriesList(categories []string, webconfig types.WebConfig) {
	<label class="flex items-center">
		<input type="radio" value="" x-model="filters.category" @change="applyFilters()" class="text-yellow-500 focus:ring-yellow-500" style="accent-color: #f4cc1d;" />
		<span class="ml-2 text-sm text-gray-700">{ webconfig.Translations["product.all_categories"] }</span>
	</label>
	for _, category := range categories {
		<label class="flex items-center">
			<input type="radio" value={ category } x-model="filters.category" @change="applyFilters()" class="text-yellow-500 focus:ring-yellow-500" style="accent-color: #f4cc1d;" />
			<span class="ml-2 text-sm text-gray-700 capitalize">{ category }</span>
		</label>
	}
} 