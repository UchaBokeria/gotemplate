package view

import (
	"main/web/app/types"
)

templ Meta(webconfig types.WebConfig) {
    <title>{ webconfig.Translations["meta.title"] }</title>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={ webconfig.Translations["meta.description"] }>
    <link rel="canonical" href="https://example.com/your-page">
    <meta name="keywords" content={ webconfig.Translations["meta.keywords"] }>
    <meta name="author" content={ webconfig.Translations["meta.author"] }>
    <meta name="robots" content="index, follow">
    <meta property="og:title" content={ webconfig.Translations["meta.title"] }>
    <meta property="og:description" content={ webconfig.Translations["meta.description"] }>
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://your-domain.com">
    <meta property="og:image" content="https://example.com/og-image.png">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content={ webconfig.Translations["meta.title"] }>
    <meta name="twitter:description" content={ webconfig.Translations["meta.description"] }>
    <meta name="twitter:image" content="https://example.com/twitter-card.png">
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="manifest" href="/manifest.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="alternate" href="https://example.com/" hreflang="en" />
    <link rel="alternate" href="https://example.com/ka/" hreflang="ka" />
    <link rel="alternate" href="https://example.com/" hreflang="x-default" />
    <link rel="preload" href="/fonts/my-font.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
                {
                "@type": "ListItem",
                "position": 1,
                "name": { webconfig.Translations["nav.home"] },
                "item": "https://example.com/"
                },
                {
                "@type": "ListItem",
                "position": 2,
                "name": { webconfig.Translations["nav.about"] },
                "item": "https://example.com/about"
                }
            ]
        }
    </script>
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": { webconfig.Translations["meta.website_name"] },
            "url": "https://example.com",
            "potentialAction": {
                "@type": "SearchAction",
                "target": "https://example.com/search?q={search_term_string}",
                "query-input": "required name=search_term_string"
            }
        }
    </script>
    <noscript>{ webconfig.Translations["meta.noscript"] }</noscript>
}
